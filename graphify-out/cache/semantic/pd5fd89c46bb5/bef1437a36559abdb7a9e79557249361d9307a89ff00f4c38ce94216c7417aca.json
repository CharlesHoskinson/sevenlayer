{"nodes": [{"id": "references_ch09_ref_29_gentry_fhe", "label": "Fully Homomorphic Encryption Using Ideal Lattices", "file_type": "paper", "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "craig_gentry", "label": "Craig Gentry", "file_type": "concept", "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fully_homomorphic_encryption", "label": "Fully Homomorphic Encryption (FHE)", "file_type": "rationale", "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Allows evaluating arbitrary circuits over encrypted data without decrypting, answering the 1978 privacy homomorphism question of Rivest, Adleman and Dertouzos."}, {"id": "bootstrapping", "label": "Bootstrapping (Homomorphic Decryption)", "file_type": "rationale", "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A scheme that can evaluate its own (augmented) decryption circuit can refresh noisy ciphertexts by decrypting homomorphically, turning a somewhat homomorphic scheme into a (leveled) fully homomorphic one."}, {"id": "ideal_lattice", "label": "Ideal Lattice", "file_type": "rationale", "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen because ideal lattices provide both additive and multiplicative homomorphisms and lattice decryption has low circuit complexity, both needed for bootstrappability."}, {"id": "squashing_decryption_circuit", "label": "Squashing the Decryption Circuit", "file_type": "rationale", "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Re-expresses decryption as a sparse subset vector sum instead of a matrix-vector product, reducing circuit depth enough to permit bootstrapping, at the cost of an extra sparse-subset-sum hardness assumption."}, {"id": "homomorphic_encryption", "label": "Homomorphic Encryption", "file_type": "rationale", "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "boneh_goh_nissim", "label": "Boneh-Goh-Nissim Cryptosystem", "file_type": "concept", "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_ch09_ref_29_gentry_fhe", "target": "craig_gentry", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "weight": 1.0}, {"source": "references_ch09_ref_29_gentry_fhe", "target": "fully_homomorphic_encryption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "weight": 1.0}, {"source": "references_ch09_ref_29_gentry_fhe", "target": "bootstrapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "weight": 1.0}, {"source": "references_ch09_ref_29_gentry_fhe", "target": "ideal_lattice", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch09/ref-29-gentry-fhe.pdf", "source_location": null, "weight": 1.0}, {"source": "references_ch09_ref_29_gentry_fhe", "target": "squashing_decryption_circuit", 