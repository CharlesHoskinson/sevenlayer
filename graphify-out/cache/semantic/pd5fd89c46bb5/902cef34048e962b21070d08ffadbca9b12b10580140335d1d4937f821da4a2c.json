{"nodes": [{"id": "references_recursion_ch3_ref_54_ethereum_rollup_centric_roadmap_doc", "label": "A Rollup-Centric Ethereum Roadmap", "file_type": "document", "source_file": "references/recursion/ch3/ref-54-ethereum-rollup-centric-roadmap.md", "source_location": null, "source_url": "https://ethereum-magicians.org/t/a-rollup-centric-ethereum-roadmap/4698", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch3_ref_54_ethereum_rollup_centric_roadmap_rollup_centric_roadmap", "label": "Rollup-Centric Roadmap", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-54-ethereum-rollup-centric-roadmap.md", "source_location": null, "source_url": "https://ethereum-magicians.org/t/a-rollup-centric-ethereum-roadmap/4698", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Base-layer scalability was years away while rollups were already live, so Ethereum retrenches to consensus and data availability (phase 1.5 and done). Sharding data availability is much safer than sharding EVM computation: fraud proofs need a strict two-epoch synchrony assumption while data availability sampling is safe under asynchrony. Also leaves economic space for L2 tokens to fund development the credibly-neutral base layer cannot."}, {"id": "references_recursion_ch3_ref_54_ethereum_rollup_centric_roadmap_zk_rollups", "label": "ZK Rollups", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-54-ethereum-rollup-centric-roadmap.md", "source_location": null, "source_url": "https://ethereum-magicians.org/t/a-rollup-centric-ethereum-roadmap/4698", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Preferred once general-purpose EVM support arrives: short finality and exit times (minutes vs days), cheaper data, better security at large value locked, low-cost privacy, and self-verifying proof generation that decentralizes better than optimistic aggregation."}, {"id": "references_recursion_ch3_ref_54_ethereum_rollup_centric_roadmap_optimistic_rollups", "label": "Optimistic Rollups", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-54-ethereum-rollup-centric-roadmap.md", "source_location": null, "source_url": "https://ethereum-magicians.org/t/a-rollup-centric-ethereum-roadmap/4698", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "The near-term workhorse because ZK rollups could not yet support general-purpose EVM computation; easily extensible to generic EVM applications unlike plasma, which suits only payments and DEX."}, {"id": "references_recursion_ch3_ref_54_ethereum_rollup_centric_roadmap_fraud_proofs", "label": "Fraud Proofs", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-54-ethereum-rollup-centric-roadmap.md", "source_location": null, "source_url": "https://ethereum-magicians.org/t/a-rollup-centric-ethereum-roadmap/4698", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch3_ref_54_ethereum_rollup_centric_roadmap_data_availability_sampling", "label": "Data Availability Sampling", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-54-ethereum-rollup-centric-roadmap.md", "source_location": null, "source_url": "https://ethereum-magicians.org/t/a-rollup-centric-ethereum-roadmap/4698", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "If done with ZKPs or polynomial commitments, safe under asynchrony - the key safety argument for sharding data rather than execution."}, {"id": "references_recursion_ch3_ref_54_ethereum_rollup_centric_roadmap_vitalik_buterin", "label": "Vitalik Buterin", "file_type": "concept", "source_file": "references/recursion/ch3/ref-54-ethereum-rollup-centric-roadmap.md", "source_location": null, "source_url": "https://ethereum-magicians.org/t/a-rollup-centric-ethereum-roadmap/4698", "captured_at": "2026-06-13", "author": null, "contributor": n