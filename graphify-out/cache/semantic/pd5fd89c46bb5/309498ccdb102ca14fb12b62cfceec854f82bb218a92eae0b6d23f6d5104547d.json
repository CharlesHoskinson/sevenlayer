{"nodes": [{"id": "references_snowball_hop2_ref_248_eprint_2021_930", "label": "Darlin: Recursive Proofs Using Marlin", "file_type": "paper", "source_file": "references/snowball/hop2/ref-248-eprint-2021-930.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ulrich_habock", "label": "Ulrich Hab\u00f6ck", "file_type": "concept", "source_file": "references/snowball/hop2/ref-248-eprint-2021-930.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "inner_sumcheck_aggregation", "label": "Inner Sumcheck Aggregation", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-248-eprint-2021-930.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Aggregating Marlin's inner sumchecks across the nodes of a recursive scheme (adapting Halo's strategy for bivariate circuit polynomials) cuts recursive prover cost by roughly 30% in a tree of in-degree 2, at the cost of about tripling proof size."}, {"id": "nested_amortization", "label": "Nested Amortization", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-248-eprint-2021-930.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The dlog commitment verifier is linear in circuit size, an obstacle for recursion; nested amortization aggregates the computational hard parts of verifiers outside the circuit, deferring them to a single expensive check at the end of recursion."}, {"id": "dlog_polynomial_commitment", "label": "Dlog (Inner-Product) Polynomial Commitment Scheme", "file_type": "concept", "source_file": "references/snowball/hop2/ref-248-eprint-2021-930.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "marlin", "label": "Marlin: Preprocessing zkSNARKs with Univ