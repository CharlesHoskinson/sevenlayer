{"nodes": [{"id": "references_ch06_ref_19_protostar", "label": "Protostar: Generic Efficient Accumulation/Folding for Special-sound Protocols", "file_type": "paper", "source_file": "references/ch06/ref-19-protostar.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benedikt_bunz", "label": "Benedikt B\u00fcnz", "file_type": "concept", "source_file": "references/ch06/ref-19-protostar.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "binyi_chen", "label": "Binyi Chen", "file_type": "concept", "source_file": "references/ch06/ref-19-protostar.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "accumulation_scheme", "label": "Accumulation Scheme", "file_type": "rationale", "source_file": "references/ch06/ref-19-protostar.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Instead of verifying a SNARK at every IVC step, verification checks are accumulated; the recursive statement only ensures accumulation was performed correctly, which is far cheaper."}, {"id": "special_sound_protocol", "label": "Special-Sound Protocol", "file_type": "rationale", "source_file": "references/ch06/ref-19-protostar.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Starting from a simple special-sound protocol with an algebraic verifier gives a generic recipe: commit to prover messages, apply Fiat-Shamir, then accumulate the NARK verifier."}, {"id": "fiat_shamir_transform", "label": "Fiat-Shamir Transform", "file_type": "rationale", "source_file": "references/ch06/ref-19-protostar.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "r1cs", "label": "Rank-1 Constraint System (R1CS)", "file_ty