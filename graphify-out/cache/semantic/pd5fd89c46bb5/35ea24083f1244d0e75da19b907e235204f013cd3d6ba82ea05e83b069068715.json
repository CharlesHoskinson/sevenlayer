{"nodes": [{"id": "references_mooc_lecture06_transcript_kzg_polynomial_commitment", "label": "KZG polynomial commitment (Kate-Zaverucha-Goldberg 2010)", "file_type": "concept", "source_file": "references/mooc/lecture06/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Constant-size commitment g^f(tau) and single-group-element proof g^q(tau) from the identity f(X)-f(u)=(X-u)q(X), verified with one pairing at the secret tau; sound under q-strong bilinear Diffie-Hellman plus knowledge-of-exponent or the generic group model; supports batch openings, Lagrange-basis linear-time commitment, and multivariate/ZK variants; drawback: trusted setup and linear-size parameters."}, {"id": "references_mooc_lecture06_transcript_bilinear_pairing", "label": "Bilinear pairing e(g^x, g^y) = e(g,g)^xy", "file_type": "concept", "source_file": "references/mooc/lecture06/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lets a verifier check product relationships in the exponent without computing them, which is exactly what KZG and BLS verification need."}, {"id": "references_mooc_lecture06_transcript_discrete_log_assumption", "label": "Discrete logarithm assumption", "file_type": "concept", "source_file": "references/mooc/lecture06/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture06_transcript_trusted_setup_ceremony", "label": "Trusted setup ceremony (distributed powers-of-tau)", "file_type": "concept", "source_file": "references/mooc/lecture06/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each contributor rerandomizes gp by powers of its secret s, proving knowledge of s and preserving the consecutive-powers structure (checked via pairings); secure if at least one participant discards their secret."}, {"id": "references_mooc_lecture06_transcript_bls_signature", "label": "BLS signature (Boneh-Lynn-Shacham 2001)", "file_type": "concept", "source_file": "references/mooc/lecture06/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture06_transcript_bulletproofs_pcs", "label": "Bulletproofs polynomial commitment (transparent halving reduction)", "file_type": "concept", "source_file": "references/mooc/lecture06/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Pedersen-committed coefficients reduced by half each round via random linear combination with cross-term commitments L and R; log-size proof, no trusted setup, but the verifier must fold the bases itself so verification is linear in the degree."}, {"id": "references_mooc_lecture06_transcript_pedersen_commitment", "label": "Pedersen vector commitment", "file_type": "concept", "source_file": "references/mooc/lecture06/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture06_transcript_hyrax", "label": "Hyrax (2D matrix commitment, sqrt-size proofs)", "file_type": "concept", "source_file": "references/mooc/lecture06/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture06_transcript_dory", "label": "Dory (log-time verifier via inner-pairing-product delegation)", "file_type": "concept", "source_file": "references/mooc/lecture06/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture06_transcript_dark", "label": "Dark (groups of unknown order, log proofs)", "file_type": "concept", "source