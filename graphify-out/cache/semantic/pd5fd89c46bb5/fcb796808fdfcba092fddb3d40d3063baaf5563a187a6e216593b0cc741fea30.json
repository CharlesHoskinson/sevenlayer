{"nodes": [{"id": "references_snowball_recursion_ref_135_labrador_compact_proofs_for_r1cs_from_module_si", "label": "LaBRADOR: Compact Proofs for R1CS from Module-SIS", "file_type": "paper", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ward_beullens", "label": "Ward Beullens", "file_type": "concept", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gregor_seiler", "label": "Gregor Seiler", "file_type": "concept", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "module_sis", "label": "Module-SIS Assumption", "file_type": "concept", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "r1cs", "label": "Rank-1 Constraint System (R1CS)", "file_type": "concept", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "recursive_composition", "label": "Recursive Proof Composition", "file_type": "rationale", "rationale": "LaBRADOR recursively amortizes because proof size becomes dominated by the constant-size last recursion step, so proofs are nearly constant (47-58KB) across practical R1CS sizes; each iteration shrinks the witness from |s| to O(|s|^(2/3)), so only O(log log n) iterations are needed.", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ajtai_commitment", "label": "Ajtai Commitment", "file_type": "concept", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "johnson_lindenstrauss_projection", "label": "Modular Johnson-Lindenstrauss Norm Projection", "file_type": "rationale", "rationale": "Direct l2-norm checks on extracted witnesses are hard in lattice proofs; random modular JL projections preserve the l2 norm up to a factor of about 2.07, and proving the projection correct comes for free as additional dot-product constraints.", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ligero", "label": "Ligero", "file_type": "concept", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "aurora", "label": "Aurora", "file_type": "concept", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bulletproofs", "label": "Bulletproofs", "file_type": "concept", "source_file": "references/snowball/recursion/ref-135-labrador-compact-proofs-for-r1cs-from-module-si.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_snowball_recursion_ref_135_labrador_compact_proofs_for_r1cs_from_module_si", 