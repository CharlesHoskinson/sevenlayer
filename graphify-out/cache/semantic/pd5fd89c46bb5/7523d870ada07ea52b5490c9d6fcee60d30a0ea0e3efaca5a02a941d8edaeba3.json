ale": "Existing bridges rely on committee honesty and have lost users more than 1.5 billion USD to attacks; replacing committees with succinct correctness proofs removes the extra trust assumption while keeping on-chain verification under 220K gas."}, {"id": "references_snowball_hop2_ref_197_doi_10_1145_3548606_3560652_block_header_relay", "label": "Succinct Block Header Relay Proofs", "file_type": "concept", "source_file": "references/snowball/hop2/ref-197-doi-10-1145-3548606-3560652.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A block header validity proof (e.g., Cosmos consensus signatures) is generated in about 2 minutes and verified on Ethereum at Groth16-level cost, enabling message passing and token transfer between heterogeneous chains."}, {"id": "references_snowball_hop2_ref_197_doi_10_1145_3548606_3560652_cross_chain_message_passing", "label": "Cross-Chain Message Passing and Token Transfer", "file_type": "concept", "source_file": "references/snowball/hop2/ref-197-doi-10-1145-3548606-3560652.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_snowball_hop2_ref_197_doi_10_1145_3548606_3560652_paper", "target": "references_snowball_hop2_ref_197_doi_10_1145_3548606_3560652_tiancheng_xie", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-197-doi-10-1145-3548606-3560652.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_197_doi_10_1145_3548606_3560652_paper", "target": "references_snowball_hop2_ref_197_doi_10_1145_3548606_3560652_jiaheng_zhang", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-197-doi-10-1145-3548606-3560652.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_r