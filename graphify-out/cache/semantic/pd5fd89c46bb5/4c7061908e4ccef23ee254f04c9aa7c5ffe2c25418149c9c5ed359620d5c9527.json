{"nodes": [{"id": "docs_superpowers_specs_2026_06_14_book_outline_design_spec", "label": "Book Outline Design (2nd Edition)", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_14_book_outline_design_trust_decomposition", "label": "Seven-Layer Trust Decomposition Thesis", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A ZK proof does not abolish trust - it decomposes one act of faith into seven independently testable, replaceable, breakable bets; the layers are the plot, each introduced under suspicion with its real-world scar."}, {"id": "docs_superpowers_specs_2026_06_14_book_outline_design_single_pass", "label": "Single Forward Pass Structure", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Intuition-first apprenticeship then the rigorous engine at the center: front-loading sum-check/IOP/MLE would lose most readers by page 40, and a two-lap walk would re-walk the layers twice."}, {"id": "docs_superpowers_specs_2026_06_14_book_outline_design_feynman_spiral", "label": "Feynman Spiral (met intuitively, locked rigorously)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_14_book_outline_design_debt_ledger", "label": "Debt Ledger Device", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every trust-us-proof-comes-later note is named, tracked, and visibly paid on a named page - what lets the book defer rigor without losing reader trust."}, {"id": "docs_superpowers_specs_2026_06_14_book_outline_design_sudoku", "label": "4x4 Sudoku Running Example", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sudoku owns the mechanism and Midnight owns the consequence - a strict division of labor so the two running examples never compete on the same page."}, {"id": "docs_superpowers_specs_2026_06_14_book_outline_design_midnight", "label": "Midnight Production Case Study", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_14_book_outline_design_part_iii_engine", "label": "Part III Dependency-Pure Rigorous Engine", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "No chapter uses a tool an earlier one has not built: random evaluation, MLE + Schwartz-Zippel, sum-check/GKR, the IOP + PCS recipe, families derived, the bedrock, Fiat-Shamir/ROM/AGM."}, {"id": "docs_superpowers_specs_2026_06_14_book_outline_design_iop_pcs_recipe", "label": "IOP + PCS = SNARK Unification", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every proof system met so far is the same two-part machine - a polynomial-IOP compiled by a polynomial-commitment scheme; this unification is the book's intellectual summit."}, {"id": "docs_superpowers_specs_2026_06_14_book_outline_design_six_lens_synthesis", "label": "Six-Lens Architect Synthesis", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Six expert architects designed independent outlines against the master graph through different lenses; the narrative-arc skeleton won because it satisfies both the Feynman constraint and the definitive-volume constraint."}], "edges": [{"source": "docs_superpowers_specs_2026_06_14_book_outline_design_spec", "target": "docs_superpowers_specs_2026_06_14_book_outline_design_trust_decomposition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_14_book_outline_design_spec", "target": "docs_superpowers_specs_2026_06_14_book_outline_design_single_pass", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_14_book_outline_design_spec", "target": "docs_superpowers_specs_2026_06_14_book_outline_design_feynman_spiral", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-14-book-outline-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_14_book_outline_design_spec", "target": "docs_superpowers_specs_2026_06_14_book_outline_design_debt_ledger", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06