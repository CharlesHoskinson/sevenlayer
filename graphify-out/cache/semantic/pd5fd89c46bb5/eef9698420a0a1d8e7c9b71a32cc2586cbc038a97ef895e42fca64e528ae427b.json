{"nodes": [{"id": "references_recursion_ch3_ref_84_w3c_verifiable_credentials", "label": "W3C Verifiable Credentials Data Model v2.0", "file_type": "document", "source_file": "references/recursion/ch3/ref-84-w3c-verifiable-credentials.md", "source_location": null, "source_url": "https://www.w3.org/TR/vc-data-model-2.0/", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch3_ref_84_w3c_verifiable_credentials_verifiable_credential", "label": "Verifiable Credential", "file_type": "concept", "source_file": "references/recursion/ch3/ref-84-w3c-verifiable-credentials.md", "source_location": null, "source_url": "https://www.w3.org/TR/vc-data-model-2.0/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "A specific way to express a set of claims made by an issuer, such as a driver's license or education certificate, in an extensible data model secured from tampering."}, {"id": "references_recursion_ch3_ref_84_w3c_verifiable_credentials_three_party_ecosystem", "label": "Issuer-Holder-Verifier Ecosystem", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-84-w3c-verifiable-credentials.md", "source_location": null, "source_url": "https://www.w3.org/TR/vc-data-model-2.0/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Three-party exchange model composed of issuers, holders, and verifiers; the holder mediates presentation of credentials, which supports privacy by decoupling issuance from verification."}, {"id": "references_recursion_ch3_ref_84_w3c_verifiable_credentials_verifiable_presentation", "label": "Verifiable Presentation", "file_type": "concept", "source_file": "references/recursion/ch3/ref-84-w3c-verifiable-credentials.md", "source_location": null, "source_url": "https://www.w3.org/TR/vc-data-model-2.0/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Holder-assembled package of one or more verifiable credentials (or data derived from them) presented to a verifier, including enveloped variants."}, {"id": "references_recursion_ch3_ref_84_w3c_verifiable_credentials_selective_disclosure", "label": "Selective Disclosure (VC Data Model)", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-84-w3c-verifiable-credentials.md", "source_location": null, "source_url": "https://www.w3.org/TR/vc-data-model-2.0/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Privacy mechanism letting a holder reveal only a subset of the claims in a credential to a verifier."}, {"id": "references_recursion_ch3_ref_84_w3c_verifiable_credentials_decentralized_identifier", "label": "Decentralized Identifier (DID)", "file_type": "concept", "source_file": "references/recursion/ch3/ref-84-w3c-verifiable-credentials.md", "source_location": null, "source_url": "https://www.w3.org/TR/vc-data-model-2.0/", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch3_ref_84_w3c_verifiable_credentials_data_integrity_proof", "label": "Data Integrity and Enveloping Proofs (JOSE/COSE)", "file_type": "concept", "source_file": "references/recursion/ch3/ref-84-w3c-verifiable-credentials.md", "source_location": null, "source_url": "https://www.w3.org/TR/vc-data-model-2.0/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Two securing approaches for credentials: embedded Data Integrity proofs and enveloping signatures using JOSE/COSE, giving implementers a choice of securing mechanism."}], "edges": [{"source": "references_recursion_ch3_ref_84_w3c_verifiable_credentials", "target": "references_recursion_ch3_ref_84_w3c_verifiable_credentials_verifiable_credential", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-84-w3c-verifiable-credentials.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_8