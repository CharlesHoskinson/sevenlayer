{"nodes": [{"id": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_verifiable_delay_functions", "label": "Boneh-Bonneau-B\u00fcnz-Fisch, Verifiable Delay Functions (CRYPTO 2018)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Formalizes verifiable delay functions and gives the first candidate constructions achieving an exponential gap between sequential evaluation time and public verification time; motivated by manipulation-resistant randomness beacons and resource-efficient blockchains."}, {"id": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_dan_boneh", "label": "Dan Boneh", "file_type": "concept", "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_joseph_bonneau", "label": "Joseph Bonneau", "file_type": "concept", "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_benedikt_bunz", "label": "Benedikt B\u00fcnz", "file_type": "concept", "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_ben_fisch", "label": "Ben Fisch", "file_type": "concept", "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_verifiable_delay_function", "label": "Verifiable Delay Function (VDF)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Setup/Eval/Verify triple: requires t sequential steps to evaluate even with polynomial parallelism, yet produces a unique output verifiable in polylog(t) time. Designed so no adversary can distinguish the output from random in less than a specified wall-clock time."}, {"id": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_randomness_beacon", "label": "Randomness Beacon", "file_type": "concept", "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ideal service (Rabin) publishing unpredictable random values. VDFs are added after entropy extraction so a last-moving adversary (high-frequency trader, miner withholding blocks, last commit-reveal participant) cannot simulate outcomes fast enough to bias the beacon."}, {"id": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_time_lock_puzzle", "label": "Time-Lock Puzzle (Rivest-Shamir-Wagner)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Repeated squaring in an RSA group is inherently sequential, but unlike a VDF the verifier needs secret state to prepare and check each puzzle, so time-lock puzzles are not universally verifiable."}, {"id": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_sloth_unicorn", "label": "Sloth / Unicorn (Lenstra-Wesolowski)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chained modular square-root puzzles giving a time-asymmetric encoding; characterized by the VDF paper as a pseudo-VDF because verification is not polylog(t)."}, {"id": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_proof_of_replication", "label": "Proof of Replication", "file_type": "concept", "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Decodable VDFs give transparent proofs that a server stores a unique slow encoding of a (possibly public) file, replacing designated-verifier RSA time-lock constructions."}], "edges": [{"source": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_dan_boneh", "target": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_verifiable_delay_functions", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_joseph_bonneau", "target": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_verifiable_delay_functions", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-151-doi-10-1007-978-3-319-96884-1-25.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_benedikt_bunz", "target": "references_snowball_hop2_ref_151_doi_10_1007_978_3_319_96884_1_25_verifiable_delay_functions", "relation": "conceptual