{"nodes": [{"id": "references_snowball_hop2_ref_213_zkresear_ch_t_lookup_singularity_65_7_page", "label": "Lookup Singularity (zk research forum thread)", "file_type": "document", "source_file": "references/snowball/hop2/ref-213-zkresear-ch-t-lookup-singularity-65-7.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_213_zkresear_ch_t_lookup_singularity_65_7_lookup_singularity", "label": "Lookup Singularity", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-213-zkresear-ch-t-lookup-singularity-65-7.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Barry WhiteHat argues circuits built only from lookup arguments would give simpler languages, easier security review, and formal verification with existing tools, because lookups restrict variables to small enumerable sets while systems of polynomial equations over prime fields resist solvers and auditors; he predicts lookups will overtake polynomial constraints as big tables become feasible."}, {"id": "references_snowball_hop2_ref_213_zkresear_ch_t_lookup_singularity_65_7_lookup_arguments", "label": "Lookup Arguments", "file_type": "concept", "source_file": "references/snowball/hop2/ref-213-zkresear-ch-t-lookup-singularity-65-7.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Set-membership checks first used for efficient big-integer arithmetic, now also VM control flow and non-snark-friendly operations; used sparingly because of per-lookup prover cost."}, {"id": "references_snowball_hop2_ref_213_zkresear_ch_t_lookup_singularity_65_7_r1cs", "label": "R1CS (Rank-1 Constraint System)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-213-zkresear-ch-t-lookup-singularity-65-7.html", "source_location": null, "source_url": null, "captured_at": n