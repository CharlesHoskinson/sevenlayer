{"nodes": [{"id": "references_snowball_hop2_ref_150_eprint_2019_1021", "label": "Halo: Recursive Proof Composition without a Trusted Setup", "file_type": "paper", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "author_sean_bowe", "label": "Sean Bowe", "file_type": "concept", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "author_jack_grigg", "label": "Jack Grigg", "file_type": "concept", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "author_daira_hopwood", "label": "Daira Hopwood", "file_type": "concept", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_halo", "label": "Halo", "file_type": "concept", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First practical recursive proof composition without trusted setup: 3.5 KiB fully-recursive proofs and a recursion threshold under 2^17 gates, using discrete log over a normal 255-bit curve cycle instead of pairing-friendly cycles."}, {"id": "concept_recursive_proof_composition", "label": "Recursive Proof Composition", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proofs attesting to other instances of themselves let unbounded computation be verified with a single proof, e.g. blockchain participants need only the current state plus one proof."}, {"id": "concept_ivc", "label": "Incrementally Verifiable Computation (IVC)", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_inner_product_argument", "label": "Inner Product Argument", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_nested_amortization", "label": "Nested Amortization", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The verification circuit never performs linear-time operations; claimed outputs become public inputs and a helper argument collapses the deferred checks, so full verification happens once at the end of the recursive chain, bypassing the need for full succinctness."}, {"id": "concept_tweedle_curve_cycle", "label": "Tweedledum/Tweedledee Curve Cycle", "file_type": "concept", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Non-pairing 255-bit prime-order cycle chosen because pairing-friendly cycles need ~780-bit fields and trusted setups; such discrete-log cycles are easy to construct and support endomorphisms that shrink the verification circuit."}, {"id": "concept_bulletproofs", "label": "Bulletproofs", "file_type": "concept", "source_file": "references/snowball/hop2/ref-150-eprint-2019-1021.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_trusted_setup", "lab