{"nodes": [{"id": "references_recursion_ch3_ref_56_ethereum_org_zkevm_roadmap_doc", "label": "Ethereum Roadmap (ethereum.org)", "file_type": "document", "source_file": "references/recursion/ch3/ref-56-ethereum-org-zkevm-roadmap.md", "source_location": null, "source_url": "https://ethereum.org/en/roadmap/", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch3_ref_56_ethereum_org_zkevm_roadmap_zkevm", "label": "zkEVM", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-56-ethereum-org-zkevm-roadmap.md", "source_location": null, "source_url": "https://ethereum.org/en/roadmap/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Zero-knowledge proofs could let validators verify Ethereum blocks without re-executing transactions, enabling higher gas limits without raising hardware requirements."}, {"id": "references_recursion_ch3_ref_56_ethereum_org_zkevm_roadmap_danksharding", "label": "Danksharding", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-56-ethereum-org-zkevm-roadmap.md", "source_location": null, "source_url": "https://ethereum.org/en/roadmap/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Makes L2 rollups much cheaper by adding blobs of data to Ethereum blocks; shard chains were dropped from the roadmap because rollups plus blob data scaled faster than expected."}, {"id": "references_recursion_ch3_ref_56_ethereum_org_zkevm_roadmap_peerdas", "label": "PeerDAS", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-56-ethereum-org-zkevm-roadmap.md", "source_location": null, "source_url": "https://ethereum.org/en/roadmap/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Peer-to-peer data availability sampling (shipped in Fusaka) enables more efficient data availability for rollups while keeping node operation accessible."}, {"id": "references_recursion_ch3_ref_5