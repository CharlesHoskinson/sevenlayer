{"nodes": [{"id": "references_snowball_hop2_ref_182_doi_10_1007_978_3_030_45721_1_27_fractal", "label": "Chiesa-Ojha-Spooner, Fractal: Post-Quantum and Transparent Recursive Proofs from Holography (EUROCRYPT 2020)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-182-doi-10-1007-978-3-030-45721-1-27.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First efficient recursive SNARK composition that is post-quantum and transparent, avoiding pairing-friendly curve cycles: holographic IOPs compile to preprocessing SNARGs in the (quantum) random oracle model, and a SNARK verifier for 2M constraints fits in 1.7M constraints, enabling arbitrary recursion depth."}, {"id": "references_snowball_hop2_ref_182_doi_10_1007_978_3_030_45721_1_27_dev_ojha", "label": "Dev Ojha", "file_type": "concept", "source_file": "references/snowball/hop2/ref-182-doi-10-1007-978-3-030-45721-1-27.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_182_doi_10_1007_978_3_030_45721_1_27_holographic_proof", "label": "Holographic Proof", "file_type": "concept", "source_file": "references/snowball/hop2/ref-182-doi-10-1007-978-3-030-45721-1-27.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The verifier queries an encoding of the circuit instead of reading it, enabling sublinear verification for arbitrary circuits; Fractal's holographic IOP for R1CS is the first with efficient indexer, prover, and verifier."}, {"id": "references_snowball_hop2_ref_182_doi_10_1007_978_3_030_45721_1_27_preprocessing_snark", "label": "Preprocessing SNARK", "file_type": "concept", "source_file": "references/snowball/hop2/ref-182-doi-10-1007-978-3-030-45721-1-27.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Offline phase produces a short circuit summary; online verification runs polylogarithmic in circuit size. Recursive composition is simpler for preprocessing SNARKs \u2014 the observation Fractal's methodology starts from."}, {"id": "references_snowball_hop2_ref_182_doi_10_1007_978_3_030_45721_1_27_recursive_composition", "label": "Recursive Proof Composition", "file_type": "concept", "source_file": "references/snowball/hop2/ref-182-doi-10-1007-978-3-030-45721-1-27.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Producing a SNARK about a computation that validates prior SNARKs; requires an argument of knowledge, and prior to Fractal the only efficient approach used pairing-based SNARKs on MNT curve cycles (pre-quantum, trusted setup, expensive algebra)."}], "edges": [{"source": "references_snowball_hop2_ref_156_doi_10_1007_978_3_030_17653_2_4_alessandro_chiesa", "target": "references_snowball_hop2_ref_182_doi_10_1007_978_3_030_45721_1_27_fractal", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-182-doi-10-1007-978-3-030-45721-1-27.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_182_doi_10_1007_978_3_030_45721_1_27_dev_ojha", "target": "references_snowball_hop2_ref_182_doi_10_1007_978_3_030_45721_1_27_fractal", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-182-doi-10-1007-978-3-030-45721-1-27.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_156_doi_10_1007_978_3_030_17653_2_4_nicholas_spooner", "target": "references_snowball_hop2_ref_182_doi_10_1007_978_3_030_45721_1_27_fractal", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-182-doi-1