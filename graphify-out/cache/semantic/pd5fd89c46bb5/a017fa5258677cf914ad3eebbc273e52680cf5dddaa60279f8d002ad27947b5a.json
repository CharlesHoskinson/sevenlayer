{"nodes": [{"id": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_doc", "label": "RFC 6962: Certificate Transparency", "file_type": "document", "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "source_url": "https://www.rfc-editor.org/rfc/rfc6962", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_certificate_transparency", "label": "Certificate Transparency", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "source_url": "https://www.rfc-editor.org/rfc/rfc6962", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Publicly auditable, append-only, untrusted logs do not prevent certificate misissuance but guarantee its detection: interested parties monitor logs, and Merkle trees replace blind trust with efficiently checkable consistency. Eventually clients refuse unlogged certificates, forcing CAs to log everything."}, {"id": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_hash_tree", "label": "Merkle Hash Tree", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "source_url": "https://www.rfc-editor.org/rfc/rfc6962", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Binary SHA-256 tree with domain separation between leaf and node hashes for second-preimage resistance; the append-only property of a log is technically achieved by showing any version is a superset of any previous version."}, {"id": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_audit_path", "label": "Merkle Audit Path", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "source_url": "https://www.rfc-editor.org/rfc/rfc6962", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Shortest list of additional nodes needed to compute the root from a leaf; a matching root proves the leaf exists in the tree."}, {"id": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_consistency_proof", "label": "Merkle Consistency Proof", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "source_url": "https://www.rfc-editor.org/rfc/rfc6962", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Proves the append-only property between two tree heads with at most ceil(log2(n))+1 nodes, so auditors verify updates without holding the whole log."}, {"id": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_signed_certificate_timestamp", "label": "Signed Certificate Timestamp (SCT)", "file_type": "concept", "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "source_url": "https://www.rfc-editor.org/rfc/rfc6962", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "The log's binding promise to incorporate a certificate within the Maximum Merge Delay; violating it is publicly provable misbehavior."}, {"id": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_signed_tree_head", "label": "Signed Tree Head (STH)", "file_type": "concept", "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "source_url": "https://www.rfc-editor.org/rfc/rfc6962", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Signed root plus tree size and timestamp; gossiped STHs let everyone detect a log presenting conflicting views (split-view attack)."}], "edges": [{"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_doc", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_certificate_transparency", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_doc", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_hash_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_doc", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_audit_path", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_doc", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_consistency_proof", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_doc", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_signed_certificate_timestamp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_doc", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_signed_tree_head", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_certificate_transparency", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_hash_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_audit_path", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_hash_tree", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_consistency_proof", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_hash_tree", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_signed_certificate_timestamp", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_certificate_transparency", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_signed_tree_head", "target": "references_recursion_ch3_ref_65_rfc_6962_certificate_transparency_merkle_hash_tree", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-65-rfc-6962-certificate-transparency.md", "source_location": null, "weight": 1.0}], "hyperedges": []}