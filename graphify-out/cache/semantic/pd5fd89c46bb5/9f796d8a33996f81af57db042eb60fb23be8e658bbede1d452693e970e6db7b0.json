{"nodes": [{"id": "references_snowball_recursion_ref_131_short_invertible_elements_in_partially_splittin", "label": "Short, Invertible Elements in Partially Splitting Cyclotomic Rings and Applications to Lattice-Based Zero-Knowledge Proofs", "file_type": "paper", "source_file": "references/snowball/recursion/ref-131-short-invertible-elements-in-partially-splittin.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "vadim_lyubashevsky", "label": "Vadim Lyubashevsky", "file_type": "concept", "source_file": "references/snowball/recursion/ref-131-short-invertible-elements-in-partially-splittin.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "gregor_seiler", "label": "Gregor Seiler", "file_type": "concept", "source_file": "references/snowball/recursion/ref-131-short-invertible-elements-in-partially-splittin.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "partially_splitting_cyclotomic_ring", "label": "Partially Splitting Cyclotomic Ring", "file_type": "rationale", "source_file": "references/snowball/recursion/ref-131-short-invertible-elements-in-partially-splittin.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choosing the prime modulus so X^n+1 splits into k>2 irreducible factors keeps small-norm challenge differences invertible while enabling log-k FFT levels before Karatsuba, a factor 2-3 multiplication speedup obtained purely from algebraic properties of p."}, {"id": "challenge_set_invertibility", "label": "Challenge Set Invertibility", "file_type": "rationale", "source_file": "references/snowball/recursion/ref-131-short-invertible-elements-in-partially-splittin.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lattice z