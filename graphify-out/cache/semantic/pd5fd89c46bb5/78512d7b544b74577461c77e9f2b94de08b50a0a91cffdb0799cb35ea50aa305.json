{"nodes": [{"id": "references_snowball_hop2_ref_181_doi_10_1007_978_3_030_21568_2_4_lattice_one_out_of_many", "label": "Esgin et al., Short Lattice-Based One-out-of-Many Proofs and Applications to Ring Signatures (ACNS 2019)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-181-doi-10-1007-978-3-030-21568-2-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Resolves the open problem of extending Groth-Kohlweiss/Bootle-style one-out-of-many proofs to lattices: log-size proofs and a ring signature of 3 MB at ring size one billion (vs. 216 MB prior), the first lattice ZKP instantiated on Module-SIS to trade extracted-witness growth against speed."}, {"id": "references_snowball_hop2_ref_181_doi_10_1007_978_3_030_21568_2_4_muhammed_esgin", "label": "Muhammed F. Esgin", "file_type": "concept", "source_file": "references/snowball/hop2/ref-181-doi-10-1007-978-3-030-21568-2-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_181_doi_10_1007_978_3_030_21568_2_4_ron_steinfeld", "label": "Ron Steinfeld", "file_type": "concept", "source_file": "references/snowball/hop2/ref-181-doi-10-1007-978-3-030-21568-2-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_181_doi_10_1007_978_3_030_21568_2_4_one_out_of_many_proof", "label": "One-out-of-Many Proof", "file_type": "concept", "source_file": "references/snowball/hop2/ref-181-doi-10-1007-978-3-030-21568-2-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prove knowledge of an opening of one commitment within a set without revealing which; with Fiat-Shamir this directly yields ring signatures where public keys are commitments to secret keys."}, {"id": "references_snowball_hop2_ref_181_doi_10_1007_978_3_030_21568_2_4_ring_signature", "label": "Ring Signature", "file_type": "concept", "source_file": "references/snowball/hop2/ref-181-doi-10-1007-978-3-030-21568-2-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Anonymity tool for e-voting and cryptocurrencies; extendable to linkable variants for confidential transactions."}, {"id": "references_snowball_hop2_ref_181_doi_10_1007_978_3_030_21568_2_4_soundness_gap", "label": "Soundness Gap (Relaxed Extraction)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-181-doi-10-1007-978-3-030-21568-2-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The extractor recovers openings of gamma * Com(m; r) instead of the actual commitments \u2014 a lattice-specific complication absent from discrete-log protocols that the unforgeability proof must handle."}, {"id": "references_snowball_hop2_ref_181_doi_10_1007_978_3_030_21568_2_4_monomial_challenges", "label": "Monomial Challenges", "file_type": "concept", "source_file": "references/snowball/hop2/ref-181-doi-10-1007-978-3-030-21568-2-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Challenges of the form X^i in Z[X]/(X^d+1) give a 2d-size challenge space where doubled inverses of challenge differences have small norm; analyzed for (k+1)-special-sound protocols and avoiding special-form moduli so NTT still applies."}], "edges": [{"source": "references_snowball_hop2_ref_181_doi_10_1007_978_3_030_21568_2_4_muhammed_esgin", "target": "references_snowball_hop2_ref_181_doi_10_1007_978_3_030_21568_2_4_lattice_one_out_of_many", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-181-doi-10-1007-978-3-030-21568-2-4.html", "source_locatio