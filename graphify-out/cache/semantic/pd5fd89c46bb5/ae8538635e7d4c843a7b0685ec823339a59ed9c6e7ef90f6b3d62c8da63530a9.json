{"nodes": [{"id": "references_recursion_ch3_ref_79_c2pa_specification", "label": "C2PA Technical Specification", "file_type": "document", "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "source_url": "https://c2pa.org/specifications/specifications/2.1/specs/C2PA_Specification.html", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Deliberately makes no value judgments about whether provenance data is good or bad, only whether assertions validate as associated with the asset, correctly formed, and tamper-free; follows Technology Minimalism by relying on prior well-established techniques and enables global opt-in adoption."}, {"id": "references_recursion_ch3_ref_79_c2pa_specification_c2pa_manifest", "label": "C2PA Manifest", "file_type": "concept", "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "source_url": "https://c2pa.org/specifications/specifications/2.1/specs/C2PA_Specification.html", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Verifiable unit binding assertions, the claim, and the claim signature together via JUMBF; the set of manifests stored in an asset's Content Credential represents its provenance data and remains valid indefinitely."}, {"id": "references_recursion_ch3_ref_79_c2pa_specification_assertion", "label": "C2PA Assertion", "file_type": "concept", "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "source_url": "https://c2pa.org/specifications/specifications/2.1/specs/C2PA_Specification.html", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Statements covering asset creation, edit actions, capture device details, and content bindings; they are trust signals a human uses to assess trustworthiness, and can be redacted for privacy."}, {"id": "references_recursion_ch3_ref_79_c2pa_specification_claim", "label": "C2PA Claim", "file_type": "concept", "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "source_url": "https://c2pa.org/specifications/specifications/2.1/specs/C2PA_Specification.html", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Digitally signed entity wrapping assertions with additional information; signing produces the claim signature that anchors tamper-evidence."}, {"id": "references_recursion_ch3_ref_79_c2pa_specification_claim_generator", "label": "C2PA Claim Generator", "file_type": "concept", "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "source_url": "https://c2pa.org/specifications/specifications/2.1/specs/C2PA_Specification.html", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Hardware or software component (e.g. a C2PA-enabled camera) that binds assertions, claims, and the claim signature into a C2PA Manifest embedded in the asset."}, {"id": "references_recursion_ch3_ref_79_c2pa_specification_trust_model", "label": "C2PA Trust Model", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "source_url": "https://c2pa.org/specifications/specifications/2.1/specs/C2PA_Specification.html", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Trust decisions are based on the identity of the signer of the claim; claim signatures combined with trusted time-stamps can be validated indefinitely to check that credentials were valid and unrevoked at signing time, using X.509 certificates and trust lists."}, {"id": "references_recursion_ch3_ref_79_c2pa_specification_hard_binding", "label": "C2PA Hard Binding", "file_type": "concept", "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "source_url": "https://c2pa.org/specifications/specifications/2.1/specs/C2PA_Specification.html", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Cryptographic hashes that bind the manifest to the exact asset content, providing tamper-evidence."}, {"id": "references_recursion_ch3_ref_79_c2pa_specification_soft_binding", "label": "C2PA Soft Binding", "file_type": "concept", "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "source_url": "https://c2pa.org/specifications/specifications/2.1/specs/C2PA_Specification.html", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Content-derived (e.g. perceptual) binding that can survive transformations where a hard binding would break, allowing manifest recovery for modified assets."}], "edges": [{"source": "references_recursion_ch3_ref_79_c2pa_specification", "target": "references_recursion_ch3_ref_79_c2pa_specification_c2pa_manifest", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_79_c2pa_specification_c2pa_manifest", "target": "references_recursion_ch3_ref_79_c2pa_specification_assertion", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_79_c2pa_specification_c2pa_manifest", "target": "references_recursion_ch3_ref_79_c2pa_specification_claim", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-79-c2pa-specification.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_79_c2pa_specification_claim", "target": "references_recursion_ch3_ref_79_c2pa_specification_assertion", "relation": "references", "confidence": "EXTRACTED", "confidence_s