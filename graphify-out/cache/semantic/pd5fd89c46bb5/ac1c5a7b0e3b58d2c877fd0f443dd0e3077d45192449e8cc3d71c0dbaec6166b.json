{"nodes": [{"id": "references_snowball_hop2_ref_249_eprint_2022_1216", "label": "A Summary on the FRI Low Degree Test", "file_type": "paper", "source_file": "references/snowball/hop2/ref-249-eprint-2022-1216.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ulrich_habock", "label": "Ulrich Hab\u00f6ck", "file_type": "concept", "source_file": "references/snowball/hop2/ref-249-eprint-2022-1216.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fri_low_degree_test", "label": "FRI Low Degree Test", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-249-eprint-2022-1216.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Statistical sampling over a small FFT domain can only assure proximity, not equality; FRI's random folding reduction plus inference from a large agreement set is what makes low-degree testing usable for proving algebraic relations and building polynomial commitment schemes."}, {"id": "correlated_agreement_theorem", "label": "Correlated Agreement Theorem (Proximity Gaps)", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-249-eprint-2022-1216.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Justifies replacing many proximity checks by one random linear combination: noticeable agreement of the combination with a Reed-Solomon codeword forces joint correlated agreement of all component words on a common dense set."}, {"id": "deep_method", "label": "DEEP Algebraic Linking (DEEP-ALI)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-249-eprint-2022-1216.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "reed_solomon_code", "label": "Reed-Solomon Code", "file_