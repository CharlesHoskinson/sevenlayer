{"nodes": [{"id": "references_snowball_hop2_ref_274_eprint_2024_2099_paper", "label": "MicroNova: Folding-Based Arguments with Efficient (On-Chain) Verification", "file_type": "paper", "source_file": "references/snowball/hop2/ref-274-eprint-2024-2099.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_274_eprint_2024_2099_jiaxing_zhao", "label": "Jiaxing Zhao", "file_type": "concept", "source_file": "references/snowball/hop2/ref-274-eprint-2024-2099.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_274_eprint_2024_2099_srinath_setty", "label": "Srinath Setty", "file_type": "concept", "source_file": "references/snowball/hop2/ref-274-eprint-2024-2099.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_274_eprint_2024_2099_micronova", "label": "MicroNova", "file_type": "concept", "source_file": "references/snowball/hop2/ref-274-eprint-2024-2099.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optimizes Nova's proof compression layer so compressed IVC proofs are O(log N) group elements verifiable with O(log N) scalar multiplications plus two pairings, enabling ~2.2M-gas Ethereum verification; uses KZG so any existing universal trusted setup can be reused."}, {"id": "references_snowball_hop2_ref_274_eprint_2024_2099_microspartan", "label": "MicroSpartan", "file_type": "concept", "source_file": "references/snowball/hop2/ref-274-eprint-2024-2099.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Redesigns Spartan to minimize verifier cost: a single sum-check invocation reduces circuit satisfiability to one folded multilinear evaluation instance, at the cost of extra prover commitments tolerated because compression runs once after many IVC steps."}, {"id": "references_snowball_hop2_ref_274_eprint_2024_2099_hyperkzg", "label": "HyperKZG", "file_type": "concept", "source_file": "references/snowball/hop2/ref-274-eprint-2024-2099.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Modifies Gemini's reduction so multilinear polynomial evaluations in evaluation form reduce directly to batched univariate KZG openings without FFTs or interpolation."}, {"id": "references_snowball_hop2_ref_274_eprint_2024_2099_delegatedspartan", "label": "DelegatedSpartan", "file_type": "concept", "source_file": "references/snowball/hop2/ref-274-eprint-2024-2099.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Variant of Spartan for the non-pairing-friendly curve instance: the verifier exploits the repetitive circuit structure to evaluate R1CS matrix MLEs itself and delegates the polynomial evaluation to the prover via MicroSpartan, avoiding infeasible on-chain MSMs over Grumpkin."}, {"id": "references_snowball_hop2_ref_274_eprint_2024_2099_half_pairing_curve_cycle", "label": "Half-Pairing Curve Cycle (BN254/Grumpkin)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-274-eprint-2024-2099.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen so the on-chain verifier can use Ethereum's BN254 precompiles and KZG commitments, while a CycleFold-style strategy shrinks the circuit on the non-pairing-friendly curve to ~1,300 gates."}, {"id": "references_snowball_hop2_ref_274_eprint_2024_2099_nova_paper", "label": "Kothapalli-Setty-Tzialla, Nova: Recursive Zero-Knowledge Arguments from Folding Schemes (CRYPTO 2022)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-274-eprint-2024-2099.pdf"