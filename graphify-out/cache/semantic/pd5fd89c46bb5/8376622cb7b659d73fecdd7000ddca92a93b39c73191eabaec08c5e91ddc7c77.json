{"nodes": [{"id": "_claude_skills_llm_wiki_references_conventions_conventions", "label": "Wiki Page and Link Conventions", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_llm_wiki_references_conventions_page_types", "label": "Five Wiki Page Types", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Concepts are atomic (one idea per page \u2014 splitting is correct, merging usually wrong), sources and syntheses are deliberately aggregate, entities map one-per-proper-noun; this keeps cross-reference links precise."}, {"id": "_claude_skills_llm_wiki_references_conventions_wikilinks", "label": "Wikilink-Only Internal Linking", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Markdown links break Obsidian backlinks, graph view, and Dataview queries; standardizing on [[wikilinks]] keeps all three working. Renames must go through Obsidian or update all referrers in the same commit."}, {"id": "_claude_skills_llm_wiki_references_conventions_provenance_marker", "label": "Inline Provenance Marker", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A bare source link without a locator is insufficient (UNSOURCED lint defect); quote anchors written only from the open raw file prevent hallucination drift from prior model memory."}, {"id": "_claude_skills_llm_wiki_references_conventions_contradiction_handling", "label": "Append-Never-Overwrite Contradiction Rule", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When sources disagree, both positions go in a [!conflict] callout with status: contested; deciding which claim is canonical is a human decision, never Claude's. Supersession (newer authoritative value) is distinct and keeps a dated note of the old value."}, {"id": "_claude_skills_llm_wiki_references_conventions_orphan_prevention", "label": "Orphan Prevention Rule", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every new page needs one outbound wikilink, one MOC entry, and one category index entry before commit so it stays discoverable in the graph."}, {"id": "_claude_skills_llm_wiki_references_conventions_frontmatter_schema", "label": "Wiki Frontmatter Schema", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "created/updated are explicit ISO dates because git resets filesystem mtime on checkout \u2014 file.ctime cannot be trusted."}, {"id": "_claude_skills_llm_wiki_references_conventions_dedup_before_create", "label": "Dedup Before Create", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-step search (index.md, category _index.md, aliases) plus filename-equals-canonical-title makes re-ingest idempotent and prevents duplicate pages."}, {"id": "_claude_skills_llm_wiki_references_conventions_moc_discipline", "label": "Index Router and MOC Discipline", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "index.md is a router, not a full listing \u2014 keeping per-query token cost roughly flat as the wiki grows; MOCs split at ~25-30 entries so any navigational file stays scannable in one pass. Links express aboutness; tags express context/state."}, {"id": "_claude_skills_llm_wiki_references_conventions_zes_tiers", "label": "ZES Evidence Tiers", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Optional 0-3 strength annotations for fine-grained epistemic tracking; the core status field remains mandatory."}], "edges": [{"source": "_claude_skills_llm_wiki_references_conventions_conventions", "target": "_claude_skills_llm_wiki_references_conventions_page_types", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_conventions_conventions", "target": "_claude_skills_llm_wiki_references_conventions_wikilinks", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_conventions_conventions", "target": "_claude_skills_llm_wiki_references_conventions_provenance_marker", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/llm-wiki/references/conventions.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_conventions_conventions", "