{"nodes": [{"id": "references_mooc_lecture10_transcript", "label": "MOOC Lecture 10: Recursive SNARKs, IVC, and Folding Schemes", "file_type": "document", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null}, {"id": "references_mooc_lecture10_transcript_recursive_snark", "label": "Recursive SNARK (Proof of a Proof)", "file_type": "rationale", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null, "rationale": "Prove knowledge of a proof rather than the witness: enables proof compression (fast inner prover + short outer proof), streaming proof generation for rollups, and prover markets. Extractor composition forces recursion depth to be logarithmic, and random-oracle gates in the verifier must be instantiated with a concrete hash (e.g. Poseidon) before recursion, at the cost of an extra assumption."}, {"id": "references_mooc_lecture10_transcript_incrementally_verifiable_computation", "label": "Incrementally Verifiable Computation (IVC)", "file_type": "rationale", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null, "rationale": "Each step outputs the new state plus a proof that the step is correct AND that the previous proof verified; iterated extraction recovers the whole trace. Lets a prover handle arbitrarily long computations (a microprocessor stepped repeatedly) with memory bounded by one step - used for succinct blockchain state proofs and VDFs."}, {"id": "references_mooc_lecture10_transcript_folding_scheme", "label": "Folding Scheme", "file_type": "rationale", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null, "rationale": "Compresses two instances into one via a random linear combination so only a single folded instance ever needs a SNARK; replaces running the whole verifier circuit inside recursion with just two group multiplications plus hashing."}, {"id": "references_mooc_lecture10_transcript_relaxed_r1cs", "label": "Relaxed R1CS", "file_type": "rationale", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null, "rationale": "Adds a scalar c and error vector E (Az o Bz = c*Dz + E) so random linear combinations of R1CS instances stay in the language; E is replaced by an additively homomorphic commitment to keep instances succinct for the verifier."}, {"id": "references_mooc_lecture10_transcript_nova", "label": "Nova", "file_type": "concept", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null}, {"id": "references_mooc_lecture10_transcript_supernova", "label": "SuperNova", "file_type": "concept", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null, "rationale": "Extends Nova to chains mixing multiple functions F1..Fk instead of one repeated F."}, {"id": "references_mooc_lecture10_transcript_sangria", "label": "Sangria", "file_type": "concept", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null, "rationale": "Observes Nova's folding applies to any quadratic constraint system, so Plonk arithmetization can be folded directly, giving smaller witnesses."}, {"id": "references_mooc_lecture10_transcript_cycles_of_elliptic_curves", "label": "Cycles of Elliptic Curves", "file_type": "rationale", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null, "rationale": "Two curves where the order of each equals the base field of the other let recursion ping-pong between groups so prover and verifier arithmetic always match, avoiding the huge circuits of field emulation; a group of order p over Fp is impossible (discrete log is easy)."}, {"id": "references_mooc_lecture10_transcript_pasta_curves", "label": "Pasta Curves (Pallas and Vesta)", "file_type": "concept", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null, "rationale": "Type-III two-cycle (no pairings) built from y^2=x^3+5 via the Silverman-Stange theorem; designed for Halo2 recursion with non-pairing polynomial commitments."}, {"id": "references_mooc_lecture10_transcript_field_emulation", "label": "Field Emulation", "file_type": "concept", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null, "rationale": "Implements Fq arithmetic as a circuit over Fp; correct but blows up the verifier circuit (e.g. pairing checks), making the recursive prover very slow."}, {"id": "references_mooc_lecture10_transcript_mina_blockchain", "label": "Mina Blockchain", "file_type": "concept", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null}, {"id": "references_mooc_lecture10_transcript_verifiable_delay_function", "label": "Verifiable Delay Function", "file_type": "concept", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null}, {"id": "references_mooc_lecture10_transcript_additively_homomorphic_commitment", "label": "Additively Homomorphic Commitment", "file_type": "concept", "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Dan Boneh", "contributor": null, "rationale": "com(m1)+com(m2)=com(m1+m2); required so the folding verifier can fold committed error vectors it never sees (e.g. Pedersen commitments)."}], "edges": [{"source": "references_mooc_lecture10_transcript", "target": "references_mooc_lecture10_transcript_recursive_snark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture10_transcript", "target": "references_mooc_lecture10_transcript_incrementally_verifiable_computation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture10_transcript", "target": "references_mooc_lecture10_transcript_folding_scheme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture10_transcript", "target": "references_mooc_lecture10_transcript_relaxed_r1cs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture10_transcript", "target": "references_mooc_lecture10_transcript_nova", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture10/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture10_transcript", "target": "references_mooc_lecture10_tr