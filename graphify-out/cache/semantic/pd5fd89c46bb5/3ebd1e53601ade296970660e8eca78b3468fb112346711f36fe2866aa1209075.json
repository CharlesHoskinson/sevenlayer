{"nodes": [{"id": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_algebraic_reductions_of_knowledge", "label": "Kothapalli-Parno, Algebraic Reductions of Knowledge (CRYPTO 2023)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-158-doi-10-1007-978-3-031-38551-3-21.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Introduces reductions of knowledge as a compositional framework: complex recursive arguments over linear-algebraic statements are decomposed into sequences of simpler knowledge reductions, unifying a growing class of modern techniques."}, {"id": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_abhiram_kothapalli", "label": "Abhiram Kothapalli", "file_type": "concept", "source_file": "references/snowball/hop2/ref-158-doi-10-1007-978-3-031-38551-3-21.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_bryan_parno", "label": "Bryan Parno", "file_type": "concept", "source_file": "references/snowball/hop2/ref-158-doi-10-1007-978-3-031-38551-3-21.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_reduction_of_knowledge", "label": "Reduction of Knowledge", "file_type": "concept", "source_file": "references/snowball/hop2/ref-158-doi-10-1007-978-3-031-38551-3-21.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generalizes arguments of knowledge: reduces checking knowledge of a witness in one relation to checking knowledge of a witness in a simpler relation, enabling modular reasoning about individual steps of complex arguments."}, {"id": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_tensor_reduction_of_knowledge", "label": "Tensor Reduction of Knowledge", "file_type": "concept", "source_file": "references/snowball/hop2/ref-158-doi-10-1007-978-3-031-38551-3-21.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generalizes the central reductive step common to many recursive arguments: for modules U = U1 tensor U2, evaluating a homomorphism in U reduces to evaluating homomorphisms in U1 and U2."}], "edges": [{"source": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_abhiram_kothapalli", "target": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_algebraic_reductions_of_knowledge", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-158-doi-10-1007-978-3-031-38551-3-21.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_bryan_parno", "target": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_algebraic_reductions_of_knowledge", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-158-doi-10-1007-978-3-031-38551-3-21.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_algebraic_reductions_of_knowledge", "target": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_reduction_of_knowledge", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-158-doi-10-1007-978-3-031-38551-3-21.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_algebraic_reductions_of_knowledge", "target": "references_snowball_hop2_ref_158_doi_10_1007_978_3_031_38551_3_21_tensor_reduction_of_k