{"nodes": [{"id": "references_mooc_lecture04_transcript_sum_check_protocol", "label": "Sum-check protocol (Lund-Fortnow-Karloff-Nisan)", "file_type": "concept", "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifier offloads summing an l-variate polynomial over the Boolean hypercube: one round per variable, O(d*l) communication, a single oracle query at the end; soundness error d*l/|F|; prover runs in near-optimal time."}, {"id": "references_mooc_lecture04_transcript_multilinear_extension", "label": "Multilinear extension", "file_type": "concept", "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Unique multilinear polynomial agreeing with f on the hypercube; a distance-amplified encoding - functions differing at one input have extensions differing almost everywhere - and evaluable from f's table in O(2^l) time via Lagrange interpolation."}, {"id": "references_mooc_lecture04_transcript_merkle_tree", "label": "Merkle tree (vector commitment)", "file_type": "concept", "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Binding via hash collision resistance with logarithmic opening proofs; alone it is NOT a polynomial commitment: committing to all evaluations guarantees no low-degree structure and costs the prover domain-size, not degree, time."}, {"id": "references_mooc_lecture04_transcript_counting_triangles_protocol", "label": "Counting-triangles interactive proof", "file_type": "concept", "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture04_transcript_circuit_transcript_iop", "label": "Sum-check-based polynomial IOP for circuit satisfiability", "file_type": "concept", "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prover commits to an extension h of the circuit transcript; a derived polynomial g_h built from add/mult wiring predicates vanishes on the hypercube iff the transcript is correct; checked by sum-check instead of quotient polynomials, avoiding large FFTs and extra committed polynomials."}, {"id": "references_mooc_lecture04_transcript_lagrange_interpolation", "label": "Lagrange interpolation / basis polynomials", "file_type": "concept", "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_mooc_lecture04_transcript_sum_check_protocol", "target": "references_mooc_lecture04_transcript_multilinear_extension", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture04_transcript_sum_check_protocol", "target": "references_mooc_lecture02_transcript_schwartz_zippel_lemma", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture04_transcript_counting_triangles_protocol", "target": "references_mooc_lecture04_transcript_sum_check_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture04_transcript_circuit_transcript_iop", "target": "references_mooc_lecture04_transcript_sum_check_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture04_transcript_circuit_transcript_iop", "target": "references_mooc_lecture04_transcript_multilinear_extension", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture04_transcript_circuit_transcript_iop", "target": "references_mooc_lecture02_transcript_polynomial_commitment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture04_transcript_circuit_transcript_iop", "target": "references_mooc_lecture02_transcript_snark", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture04_transcript_merkle_tree", "target": "references_mooc_lecture02_transcript_vector_commitment", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture04_transcript_multilinear_extension", "target": "references_mooc_lecture04_transcript_lagrange_interpolation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture04/transcript.txt", "source_location": null, "weight": 1.0}], "hyperedges": []}