{"nodes": [{"id": "references_snowball_book_ref_142_zksync_scaling_and_privacy_engine_for_ethereum_document", "label": "zkSync: Scaling and Privacy Engine for Ethereum (Technical Documentation 2020)", "file_type": "document", "source_file": "references/snowball/book/ref-142-zksync-scaling-and-privacy-engine-for-ethereum.md", "source_location": null, "source_url": "https://zksync.io", "captured_at": "2026-06-14", "author": null, "contributor": null}, {"id": "references_snowball_book_ref_142_zksync_scaling_and_privacy_engine_for_ethereum_zk_stack", "label": "ZK Stack", "file_type": "concept", "source_file": "references/snowball/book/ref-142-zksync-scaling-and-privacy-engine-for-ethereum.md", "source_location": null, "source_url": "https://zksync.io", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Open-source framework for building customizable, enterprise-grade ZK blockchains that scale globally, interoperate natively, and inherit Ethereum's security; enterprises choose chain type (rollup/validium), data availability, gas token, sequencing, and permissioned vs. permissionless access."}, {"id": "references_snowball_book_ref_142_zksync_scaling_and_privacy_engine_for_ethereum_prividium", "label": "Prividium", "file_type": "concept", "source_file": "references/snowball/book/ref-142-zksync-scaling-and-privacy-engine-for-ethereum.md", "source_location": null, "source_url": "https://zksync.io", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Permissioned validium: private, Ethereum-secured L2 that keeps transaction data and state off-chain while posting only ZK validity proofs to Ethereum. Resolves the bank dilemma of control vs. connectivity \u2014 private execution with public verifiability, selective regulator disclosure, and no trusted operator required."}, {"id": "references_snowball_book_ref_142_zksync_scaling_and_privacy_engine_for_ethereum_airbender", "label": "Airbender", "file_type": "concept", "source_file": "references/snowball/book/ref-142-zksync-scaling-and-privacy-engine-for-ethereum.md", "source_location": null, "source_url": "https://zksync.io", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "RISC-V prover delivering subsecond block proofs and minutes-to-Ethereum settlement on commodity GPUs (~$0.0001/transfer); general-purpose \u2014 compiles EVM bytecode, WASM, or Rust without code changes \u2014 enabling latency-sensitive financial activity and real-time settlement."}, {"id": "references_snowball_book_ref_142_zksync_scaling_and_privacy_engine_for_ethereum_elastic_network", "label": "Elastic Network (ZKsync Chains)", "file_type": "concept", "source_file": "references/snowball/book/ref-142-zksync-scaling-and-privacy-engine-for-ethereum.md", "source_location": null, "source_url": "https://zksync.io", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Network of interoperable public and private ZK Chains secured by cryptography rather than validators, with ~1s network hops, minutes-to-Ethereum finality, and atomic privacy-preserving cross-chain settlement (ZKsync Connect) that eliminates third-party bridges."}, {"id": "references_snowball_book_ref_142_zksync_scaling_and_privacy_engine_for_ethereum_tokenized_deposits", "label": "Tokenized Deposits", "file_type": "concept", "source_file": "references/snowball/book/ref-142-zksync-scaling-and-privacy-engine-for-ethereum.md", "source_location": null, "source_url": "https://zksync.io", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Programmable, always-on digital money issued by regulated banks and anchored to Ethereum, combining blockchain programmability with deposit insurance and the regulatory framework of traditional banking; Cari Network is onboarding U.S. regional banks with $600B+ in deposits onto Prividium."}], "edges": [{"source": "references_snowball_book_ref_142_zksync_scaling_and_privacy_engine_for_ethereum