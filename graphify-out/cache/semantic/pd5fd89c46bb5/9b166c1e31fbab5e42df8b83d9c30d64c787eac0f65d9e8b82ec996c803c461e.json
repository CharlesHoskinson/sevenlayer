confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_transcript", "target": "references_mooc_lecture08_transcript_goldilocks_field", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_transcript_fri", "target": "references_mooc_lecture08_transcript_polynomial_commitment_scheme", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_transcript_fri", "target": "references_mooc_lecture08_transcript_reed_solomon_code", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_transcript_fri", "target": "references_mooc_lecture08_transcript_roots_of_unity", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_transcript_fri_folding_phase", "target": "references_mooc_lecture08_transcript_fri", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_transcript_fri_query_phase", "target": "references_mooc_lecture08_transcript_fri", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_trans