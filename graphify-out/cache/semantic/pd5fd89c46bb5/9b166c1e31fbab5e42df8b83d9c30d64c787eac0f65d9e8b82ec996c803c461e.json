{"nodes": [{"id": "references_mooc_lecture08_transcript", "label": "MOOC Lecture 8: FRI Polynomial Commitments and the Fiat-Shamir Transformation", "file_type": "document", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null}, {"id": "references_mooc_lecture08_transcript_fri", "label": "FRI Polynomial Commitment Scheme", "file_type": "rationale", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null, "rationale": "Hash-based, transparent, plausibly post-quantum; shortest evaluation proofs among hashing-based schemes. Blowup factor rho^-1 trades prover time (grows linearly) against proof size/verification (falls logarithmically). Only ~0.5*log(1/rho) bits of security per query are provable; deployments assume the conjectured log(1/rho) bits, which a simple interpolation attack shows is tight."}, {"id": "references_mooc_lecture08_transcript_fiat_shamir_transformation", "label": "Fiat-Shamir Transformation", "file_type": "rationale", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null, "rationale": "Replaces verifier randomness with a hash of the transcript to make protocols non-interactive. Public input x must be hashed for adaptive security (a recurring deployment bug). Applying it to many-round protocols can be catastrophically insecure unless the protocol is round-by-round sound; non-interactive deployment demands far higher security levels because grinding is silent."}, {"id": "references_mooc_lecture08_transcript_polynomial_iop", "label": "Polynomial IOP", "file_type": "concept", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null}, {"id": "references_mooc_lecture08_transcript_polynomial_commitment_scheme", "label": "Polynomial Commitment Scheme", "file_type": "concept", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null, "rationale": "Lets the prover commit to a large polynomial with a single hash/group element and later prove evaluations, so a polynomial IOP can run succinctly. The SNARK inherits transparency and post-quantum status entirely from the commitment scheme."}, {"id": "references_mooc_lecture08_transcript_kzg_commitments", "label": "KZG Polynomial Commitments", "file_type": "rationale", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null, "rationale": "Constant-size commitments and evaluation proofs via pairing-friendly groups; best known verification costs, but requires a trusted setup and is not post-quantum."}, {"id": "references_mooc_lecture08_transcript_reed_solomon_code", "label": "Reed-Solomon Code", "file_type": "concept", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null}, {"id": "references_mooc_lecture08_transcript_roots_of_unity", "label": "Multiplicative Subgroup of n-th Roots of Unity", "file_type": "rationale", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null, "rationale": "The squaring map is 2-to-1 on the n-th roots of unity (n even), halving the evaluation domain at each FRI fold; requires n | p-1, which is why FRI fields like Goldilocks (2^64-2^32+1) have large power-of-two subgroups."}, {"id": "references_mooc_lecture08_transcript_fri_folding_phase", "label": "FRI Folding Phase", "file_type": "concept", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null}, {"id": "references_mooc_lecture08_transcript_fri_query_phase", "label": "FRI Query Phase", "file_type": "concept", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null}, {"id": "references_mooc_lecture08_transcript_grinding_attack", "label": "Grinding Attack on Fiat-Shamir", "file_type": "rationale", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null, "rationale": "Attacker iterates first messages until one hashes to a lucky challenge: 2^b hashes succeed with probability 2^(b-lambda), linearly better than birthday-style attacks; motivates >=128-bit security since 2^80 hashes/hour are feasible (Bitcoin network)."}, {"id": "references_mooc_lecture08_transcript_round_by_round_soundness", "label": "Round-by-Round Soundness", "file_type": "rationale", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null, "rationale": "Ensures a cheating prover must get lucky all at once in a single round, ruling out the per-round grinding that makes Fiat-Shamir on sequentially-repeated protocols totally insecure; known for sum-check and Bulletproofs but not yet published for FRI."}, {"id": "references_mooc_lecture08_transcript_list_polynomial_commitment", "label": "List Polynomial Commitment", "file_type": "rationale", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null, "rationale": "Binds the prover to a small set of low-degree polynomials rather than a unique one; still suffices for SNARK security and lets FRI deployments claim log(1/rho) bits per query instead of operating inside the unique decoding radius."}, {"id": "references_mooc_lecture08_transcript_goldilocks_field", "label": "Goldilocks Field (2^64 - 2^32 + 1)", "file_type": "concept", "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Justin Thaler", "contributor": null}], "edges": [{"source": "references_mooc_lecture08_transcript", "target": "references_mooc_lecture08_transcript_fri", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_transcript", "target": "references_mooc_lecture08_transcript_fiat_shamir_transformation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_transcript", "target": "references_mooc_lecture08_transcript_polynomial_iop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_transcript", "target": "references_mooc_lecture08_transcript_polynomial_commitment_scheme", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture08_transcript", "target": "references_mooc_lecture08_transcript_kzg_commitments", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture08/transcript.txt", "sour