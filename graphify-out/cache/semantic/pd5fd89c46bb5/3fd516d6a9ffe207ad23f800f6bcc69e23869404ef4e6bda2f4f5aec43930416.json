{"nodes": [{"id": "docs_superpowers_specs_2026_06_12_book_graph_comparison_design_spec", "label": "Book Graph Comparison Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-12-book-graph-comparison-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_12_book_graph_comparison_design_book_graph", "label": "Book Graph (book-graph/)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-book-graph-comparison-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An independent manuscript-only graph in its own directory never touches graph 1, preserving a clean comparison baseline."}, {"id": "docs_superpowers_specs_2026_06_12_book_graph_comparison_design_chapter_split_extraction", "label": "Per-Chapter Split Extraction", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-12-book-graph-comparison-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A single-file extraction of the 919 KB manuscript extracts shallowly (the same failure dense PDFs showed), so the book is split at chapter headings with one extraction subagent per chapter."}, {"id": "docs_superpowers_specs_2026_06_12_book_graph_comparison_design_reference_augmentation", "label": "Reference Subgraph Augmentation", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-book-graph-comparison-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reuses graph 1's already-mined reference nodes instead of re-extracting; scrapling re-runs only as an idempotent confirmation of the corpus."}, {"id": "docs_superpowers_specs_2026_06_12_book_graph_comparison_design_vocabulary_drift", "label": "Vocabulary Dri