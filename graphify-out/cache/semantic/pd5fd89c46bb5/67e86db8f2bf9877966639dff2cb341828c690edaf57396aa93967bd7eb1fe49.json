{"nodes": [{"id": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_spec", "label": "Sevenlayer Wiki Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-04-18-sevenlayer-wiki-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_two_phase_extraction", "label": "Two-Phase Extraction Strategy", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-04-18-sevenlayer-wiki-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Parallel mechanical extraction first, then an enrichment pass with global visibility - extraction is embarrassingly parallel but enrichment needs cross-chapter context (entity map, dependencies, contradictions)."}, {"id": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_node_schema", "label": "Rich Section Node Schema", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-18-sevenlayer-wiki-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_five_dimensions", "label": "Five Audit Dimensions (Accuracy, Citations, Clarity, Coherence, Depth)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-18-sevenlayer-wiki-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Severity tags P0-P3 keep the audit honest: the improvement loop acts only on P0/P1, so style over-flagging cannot dominate revision."}, {"id": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_improvement_loop", "label": "Chapter-by-Chapter Improvement Loop", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-04-18-sevenlayer-wiki-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One chapter per cycle because section-level rewrites risk losing transitions; chapters ordered by P0/P1 finding density."}], "edges": [{"source": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_spec", "target": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_two_phase_extraction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-18-sevenlayer-wiki-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_spec", "target": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_node_schema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-18-sevenlayer-wiki-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_spec", "target": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_five_dimensions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-18-sevenlayer-wiki-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_spec", "target": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_improvement_loop", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-18-sevenlayer-wiki-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_improvement_loop", "target": "docs_superpowers_specs_2026_04_18_sevenlayer_wiki_design_five_dimensions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-18-sevenlayer-wiki-design.md", "source