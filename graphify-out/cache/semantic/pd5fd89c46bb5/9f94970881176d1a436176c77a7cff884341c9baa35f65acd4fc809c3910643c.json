{"nodes": [{"id": "references_mooc_lecture14_transcript", "label": "MOOC Lecture 14: Securing ZK Circuits with Formal Methods (Veridise)", "file_type": "document", "source_file": "references/mooc/lecture14/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yu Feng", "contributor": null}, {"id": "references_mooc_lecture14_transcript_abstract_interpretation", "label": "Abstract Interpretation", "file_type": "concept", "source_file": "references/mooc/lecture14/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yu Feng", "contributor": null, "rationale": "Computes conservative over-approximations of program state to detect known vulnerability patterns (re-entrancy, overflow) without specifications; imprecise abstractions yield false positives/negatives."}, {"id": "references_mooc_lecture14_transcript_formal_verification", "label": "Formal Verification", "file_type": "concept", "source_file": "references/mooc/lecture14/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yu Feng", "contributor": null, "rationale": "Proves code matches a formal specification via VC generation and theorem provers; strongest guarantee, but needs manual specs and existing SMT solvers struggle with non-linear arithmetic over large prime fields ubiquitous in ZK circuits."}, {"id": "references_mooc_lecture14_transcript_under_constrained_bugs", "label": "Under-Constrained Circuit Bugs", "file_type": "rationale", "source_file": "references/mooc/lecture14/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yu Feng", "contributor": null, "rationale": "The constraint system accepts (x,y) pairs the witness computation would reject, letting attackers forge accepted proofs (drain funds, double spend). Examples: Num2Bits off-by-one leaving an output signal unconstrained, unconstrained LessThan output in a withdraw gadget, division-by-zero admitted when division is encoded as multiplication. Over-constrained bugs are rare because in-circuit assertions surface them during development."}, {"id": "references_mooc_lecture14_transcript_circuit_dependence_graph", "label": "Circuit Dependence Graph", "file_type": "concept", "source_file": "references/mooc/lecture14/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yu Feng", "contributor": null, "rationale": "Graph abstraction of a circuit: signal nodes with data-dependency and constraint edges; vulnerability detection becomes datalog queries over the graph (e.g. output signal with no constant or input constraint path)."}, {"id": "references_mooc_lecture14_transcript_picus", "label": "Picus Verifier", "file_type": "rationale", "source_file": "references/mooc/lecture14/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yu Feng", "contributor": null, "rationale": "Verifies circuits are well-constrained by alternating a scalable static-analysis phase (grows the proven-constrained signal set) with a precise SMT phase in a loop; outperforms either technique alone because finite-field SMT solvers choke past a few hundred constraints."}, {"id": "references_mooc_lecture14_transcript_vanguard", "label": "Vanguard Static Analysis Framework", "file_type": "concept", "source_file": "references/mooc/lecture14/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yu Feng", "contributor": null, "rationale": "Compiles Circom/Halo2 circuits to circuit dependence graphs and runs pattern queries; found 32 previously unknown vulnerabilities across 258 circuits from 17 ZK projects."}, {"id": "references_mooc_lecture14_transcript_smt_solver", "label": "SMT Solver", "file_type": "concept", "source_file": "references/mooc/lecture14/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yu Feng", "contributor": null}, 