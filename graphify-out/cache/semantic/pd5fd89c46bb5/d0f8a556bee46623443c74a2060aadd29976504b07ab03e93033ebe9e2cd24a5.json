{"nodes": [{"id": "references_ch06_ref_18_hypernova", "label": "HyperNova: Recursive Arguments for Customizable Constraint Systems", "file_type": "paper", "source_file": "references/ch06/ref-18-hypernova.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "abhiram_kothapalli", "label": "Abhiram Kothapalli", "file_type": "concept", "source_file": "references/ch06/ref-18-hypernova.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "srinath_setty", "label": "Srinath Setty", "file_type": "concept", "source_file": "references/ch06/ref-18-hypernova.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ccs", "label": "Customizable Constraint System (CCS)", "file_type": "rationale", "source_file": "references/ch06/ref-18-hypernova.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "CCS simultaneously generalizes Plonkish, R1CS, and AIR without overheads, letting one folding scheme serve all major arithmetization formats."}, {"id": "multi_folding_scheme", "label": "Multi-Folding Scheme", "file_type": "rationale", "source_file": "references/ch06/ref-18-hypernova.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Folds multiple instances at once with prover cost of a single MSM, making generalizations of IVC such as PCD easier to build."}, {"id": "cyclefold", "label": "CycleFold", "file_type": "rationale", "source_file": "references/ch06/ref-18-hypernova.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "General technique for instantiating folding-scheme-based recursive arguments over a 2-cycle of elliptic curves, avoiding a full folding verifier circuit on both curves."}, {