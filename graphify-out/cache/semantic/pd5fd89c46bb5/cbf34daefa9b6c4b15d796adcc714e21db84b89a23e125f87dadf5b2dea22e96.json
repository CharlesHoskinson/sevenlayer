{"nodes": [{"id": "_claude_skills_llm_wiki_references_operations_ingest_ingest", "label": "Ingest Operation", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/ingest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The primary knowledge-accretion loop: source read in full before any claim is written (anti-hallucination guarantee), takeaways discussed with the user before writing, and index updates never deferred because index staleness is the top operational risk."}, {"id": "_claude_skills_llm_wiki_references_operations_ingest_atomic_commit", "label": "Atomic Ingest Commit", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/operations/ingest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "One commit per ingest is the unit of undo (git revert), the backup mechanism, and the provenance audit trail; partial state breaks the invariants lint and query depend on. The raw source is committed too so citations are reproducible from the repo alone."}, {"id": "_claude_skills_llm_wiki_references_operations_ingest_definition_of_done", "label": "Page Definition of Done", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/ingest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_llm_wiki_references_operations_ingest_batch_ingest", "label": "Batch Ingest", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/ingest.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Opt-in only; per-source confirmation, fresh dedup, and one atomic commit per source are preserved even in a batch."}], "edges": [{"source": "_claude_skills_llm_wiki_references_operations_ingest_ing