{"nodes": [{"id": "references_snowball_recursion_ref_141_mina_cryptocurrency_mina_protocol", "label": "Mina Protocol", "file_type": "document", "source_file": "references/snowball/recursion/ref-141-mina-cryptocurrency.md", "source_location": null, "source_url": "https://minaprotocol.com", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Positions itself as the ZK blockchain for a secure, private and verifiable internet: succinctness lowers the barrier to participation, which the project argues yields robust security and unrivaled decentralization with minimal resource requirements."}, {"id": "references_snowball_recursion_ref_141_mina_cryptocurrency_proof_of_everything", "label": "Proof of Everything (Recursive ZK Proof)", "file_type": "rationale", "source_file": "references/snowball/recursion/ref-141-mina-cryptocurrency.md", "source_location": null, "source_url": "https://minaprotocol.com", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "All chain history is rolled up into one singular, recursive, constant-sized proof so any device can join and verify the entire Mina chain in milliseconds while retaining full node security."}, {"id": "references_snowball_recursion_ref_141_mina_cryptocurrency_constant_size_succinct_blockchain", "label": "Constant-Size Succinct Blockchain (22KB)", "file_type": "rationale", "source_file": "references/snowball/recursion/ref-141-mina-cryptocurrency.md", "source_location": null, "source_url": "https://minaprotocol.com", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "A fixed 22KB chain (versus hundreds of GB and growing for other blockchains) keeps resource requirements minimal, lowering the barrier to participation and enabling decentralization."}, {"id": "references_snowball_recursion_ref_141_mina_cryptocurrency_zkapps", "label": "zkApps (Zero-Knowledge Applications)", "file_type": "concept", "source_file": "references/snowball/recursion/ref-141-mina-cryptocurrency.md", "source_location": null, "source_url": "https://minaprotocol.com", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Turing-complete TypeScript-based smart contracts with programmable privacy: user data never leaves the local device, only proofs are submitted to the chain, extending beyond the conventional definition of a smart contract."}, {"id": "references_snowball_recursion_ref_141_mina_cryptocurrency_off_chain_computation", "label": "Off-Chain Computation with On-Chain Proof Verification", "file_type": "rationale", "source_file": "references/snowball/recursion/ref-141-mina-cryptocurrency.md", "source_location": null, "source_url": "https://minaprotocol.com", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Run computation off-chain and verify a single proof representing infinite computation on-chain, reducing strain on the network, lowering fees and enhancing scalability."}, {"id": "references_snowball_recursion_ref_141_mina_cryptocurrency_composable_proofs", "label": "Composable Proofs", "file_type": "concept", "source_file": "references/snowball/recursion/ref-141-mina-cryptocurrency.md", "source_location": null, "source_url": "https://minaprotocol.com", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Mina's zero-knowledge proofs are modular: prove anything in one application and reuse it in another, across app-chains, roll-ups, zkVMs, and L2s."}], "edges": [{"source": "references_snowball_recursion_ref_141_mina_cryptocurrency_mina_protocol", "target": "references_snowball_recursion_ref_141_mina_cryptocurrency_proof_of_everything", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/recursion/ref-141-mina-cryptocurrency.md", "source_location": null, "weight": 1.0}, {"source": "references_snowball_recursion_ref_141_mina_cryptocurrency_mina_protocol", "target": "references_snowball