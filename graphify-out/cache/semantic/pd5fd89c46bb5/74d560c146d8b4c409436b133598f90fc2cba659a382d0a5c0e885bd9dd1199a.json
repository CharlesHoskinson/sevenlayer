{"nodes": [{"id": "references_snowball_book_ref_068_marlin_preprocessing_zksnarks_with_universal_an", "label": "Marlin: Preprocessing zkSNARKs with Universal and Updatable SRS", "file_type": "paper", "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal-an.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "Alessandro Chiesa, Yuncong Hu, Mary Maller, Pratyush Mishra, Psi Vesely, Nicholas Ward", "contributor": null}, {"id": "mary_maller", "label": "Mary Maller", "file_type": "concept", "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal-an.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "algebraic_holographic_proof", "label": "Algebraic Holographic Proof", "file_type": "rationale", "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal-an.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Marlin's key observation: preprocessing is closely related to holography, where the verifier queries a low-degree polynomial encoding of the circuit instead of reading it, so fast online verification and a universal SRS come from compiling any public-coin AHP with polynomial commitments."}, {"id": "universal_and_updatable_srs", "label": "Universal and Updatable SRS", "file_type": "rationale", "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal-an.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Circuit-specific SRS forces a new cryptographic ceremony for every circuit change, which is unsustainable; a universal SRS supports all circuits up to a size bound and updatability means only one honest setup participant is needed for soundness."}, {"id": "polynomial_commitment", "label": "Polynomial Commitment", "file_type": "rationale", "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal-an.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rank_1_constraint_satisfiability", "label": "Rank-1 Constraint Satisfiability", "file_type": "rationale", "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal-an.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sonic", "label": "Sonic", "file_type": "paper", "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal-an.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "groth16", "label": "Groth16", "file_type": "paper", "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal-an.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "fractal", "label": "Fractal", "file_type": "paper", "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal-an.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "kzg_polynomial_commitments", "label": "KZG Polynomial Commitments", "file_type": "paper", "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal-an.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_snowball_book_ref_068_marlin_preprocessing_zksnarks_with_universal_an", "target": "alessandro_chiesa", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/book/ref-068-marlin-preprocessing-zksnarks-with-universal