{"nodes": [{"id": "references_snowball_hop2_ref_275_eprint_2024_232_paper", "label": "On the Security of Nova Recursive Proof System: Limitations of and Alternatives to Bounded-Depth Analysis", "file_type": "paper", "source_file": "references/snowball/hop2/ref-275-eprint-2024-232.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_275_eprint_2024_232_hyeonbum_lee", "label": "Hyeonbum Lee", "file_type": "concept", "source_file": "references/snowball/hop2/ref-275-eprint-2024-232.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_275_eprint_2024_232_jae_hong_seo", "label": "Jae Hong Seo", "file_type": "concept", "source_file": "references/snowball/hop2/ref-275-eprint-2024-232.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_275_eprint_2024_232_ephemeral_nova", "label": "Ephemeral-Nova", "file_type": "concept", "source_file": "references/snowball/hop2/ref-275-eprint-2024-232.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Artificial Nova variant built to expose the gap in standard IVC knowledge soundness: a Fermat's-little-theorem trapdoor in the augmented function keeps it provably sound at logarithmic recursion depth yet efficiently forgeable at polynomial depth."}, {"id": "references_snowball_hop2_ref_275_eprint_2024_232_extended_algebraic_group_model", "label": "Extended Algebraic Group Model (EAGM)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-275-eprint-2024-232.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extends the AGM to force algebraic representations of intermediate group elements (via a Linear-Algebraic Binding function and projection), enabling straight-line recursive witness extraction without rewinding blow-up."}, {"id": "references_snowball_hop2_ref_275_eprint_2024_232_general_zero_testing", "label": "General Zero-Testing (GZT) Property", "file_type": "concept", "source_file": "references/snowball/hop2/ref-275-eprint-2024-232.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the random oracle with a targeted correlation-intractability-style requirement (hash output avoids algebraic roots defined over hidden representations), enabling straight-line extraction in the AGM with a plausible standard-model instantiation path."}, {"id": "references_snowball_hop2_ref_275_eprint_2024_232_poly_depth_knowledge_soundness", "label": "Poly-Depth Knowledge Soundness", "file_type": "concept", "source_file": "references/snowball/hop2/ref-275-eprint-2024-232.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "New IVC security definition demanding efficient extraction at polynomial recursion depth, since applications like VDFs and succinct blockchains need thousands of recursive steps per day, far beyond the O(log lambda) depth of standard definitions."}, {"id": "references_snowball_hop2_ref_275_eprint_2024_232_nova_paper", "label": "Kothapalli-Setty-Tzialla, Nova: Recursive Zero-Knowledge Arguments from Folding Schemes (CRYPTO 2022)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-275-eprint-2024-232.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_275_eprint_2024_232_valiant_ivc_paper", "label": "Valiant, Incrementally Verifiable Computation (TCC 2008)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-275-eprint-2024-232.pdf", "source_location": null, "source_url": null, "captured_at": nu