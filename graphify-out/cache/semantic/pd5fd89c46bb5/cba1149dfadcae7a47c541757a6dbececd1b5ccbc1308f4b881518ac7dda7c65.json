{"nodes": [{"id": "references_snowball_hop2_ref_184_doi_10_1007_978_3_030_56880_1_17_paper", "label": "Practical Product Proofs for Lattice Commitments", "file_type": "paper", "source_file": "references/snowball/hop2/ref-184-doi-10-1007-978-3-030-56880-1-17.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_184_doi_10_1007_978_3_030_56880_1_17_thomas_attema", "label": "Thomas Attema", "file_type": "concept", "source_file": "references/snowball/hop2/ref-184-doi-10-1007-978-3-030-56880-1-17.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_184_doi_10_1007_978_3_030_56880_1_17_bdlop_commitment", "label": "BDLOP Commitment Scheme (Baum et al., SCN 2018)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-184-doi-10-1007-978-3-030-56880-1-17.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_184_doi_10_1007_978_3_030_56880_1_17_multiplicative_relation_proof", "label": "Lattice Product Proof for Committed Values", "file_type": "concept", "source_file": "references/snowball/hop2/ref-184-doi-10-1007-978-3-030-56880-1-17.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Message maskings are derived from the already-committed randomness masking y (sent as w), so masked message openings need not be sent; this keeps the multiplicative proof (9 KB) close to the plain opening proof (7 KB)."}, {"id": "references_snowball_hop2_ref_184_doi_10_1007_978_3_030_56880_1_17_ntt_packing", "label": "NTT Coefficient Packing", "file_type": "concept", "source_file": "references/snowball/hop2/ref-184-doi-10-1007-978-3-030-56880-1-17.html", "source_location": null, "source_url": null, "captured_at": null, "author": nu