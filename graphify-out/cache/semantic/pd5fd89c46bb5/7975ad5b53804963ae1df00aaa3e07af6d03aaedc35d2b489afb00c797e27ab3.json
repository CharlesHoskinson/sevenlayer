{"nodes": [{"id": "references_snowball_hop2_ref_193_doi_10_1007_978_981_99_8724_5_3_paper", "label": "Protostar: Generic Efficient Accumulation/Folding for Special-Sound Protocols", "file_type": "paper", "source_file": "references/snowball/hop2/ref-193-doi-10-1007-978-981-99-8724-5-3.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_193_doi_10_1007_978_981_99_8724_5_3_binyi_chen", "label": "Binyi Chen", "file_type": "concept", "source_file": "references/snowball/hop2/ref-193-doi-10-1007-978-981-99-8724-5-3.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_193_doi_10_1007_978_981_99_8724_5_3_generic_accumulation_compiler", "label": "Generic Accumulation Compiler for Special-Sound Protocols", "file_type": "concept", "source_file": "references/snowball/hop2/ref-193-doi-10-1007-978-981-99-8724-5-3.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any (2k-1)-move special-sound protocol with an algebraic degree-d verifier is compiled to an accumulation scheme via homomorphic commitment to prover messages, Fiat-Shamir, and a random linear combination with error terms; the accumulation verifier needs only k+2 group scalar multiplications."}, {"id": "references_snowball_hop2_ref_193_doi_10_1007_978_981_99_8724_5_3_special_sound_protocols", "label": "Special-Sound Protocols with Algebraic Verifiers", "file_type": "concept", "source_file": "references/snowball/hop2/ref-193-doi-10-1007-978-981-99-8724-5-3.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_193_doi_10_1007_978_981_99_8724_5_3_nonuniform_ivc_plonkup", "label": "Non-uniform IVC for Plonkup (High-Degree Gates and Lookups)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-193-doi-10-1007-978-981-99-8724-5-3.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A program counter selects one of I circuits per step so a ZK-EVM style VM can use a different circuit per instruction without a recursive circuit linear in I; no trusted setup, pairings, or FFTs are needed."}, {"id": "references_snowball_hop2_ref_193_doi_10_1007_978_981_99_8724_5_3_log_derivative_lookup", "label": "Lookup Argument via Logarithmic Derivatives", "file_type": "concept", "source_file": "references/snowball/hop2/ref-193-doi-10-1007-978-981-99-8724-5-3.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Using Haboeck's logarithmic-derivative insight, a prover doing l lookups commits to only two length-l vectors, independent of the table size, and the check stays degree 2 so it remains compatible with the accumulation compiler."}, {"id": "references_snowball_hop2_ref_193_doi_10_1007_978_981_99_8724_5_3_hypernova_paper", "label": "HyperNova: Recursive Arguments for Customizable Constraint Systems", "file_type": "paper", "source_file": "references/snowball/hop2/ref-193-doi-10-1007-978-981-99-8724-5-3.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_193_doi_10_1007_978_981_99_8724_5_3_supernova_paper", "label": "SuperNova: Proving Universal Machine Executions without Universal Circuits", "file_type": "paper", "source_file": "references/snowball/hop2/ref-193-doi-10-1007-978-981-99-8724-5-3.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_193_doi_10_1007_978_981_99_8724_5_3_plonk_paper", "label": "PLONK: Permutations over Lagrange-Bases for Oecumenical Noninteractive Arguments of Knowledge", "file_type"