{"nodes": [{"id": "references_ch12_ref_39_compact_language_reference_compact_language", "label": "Compact smart contract language", "file_type": "concept", "source_file": "references/ch12/ref-39-compact-language-reference.md", "source_location": null, "source_url": "https://docs.midnight.network/compact/reference/compact-reference", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "Bounded by design - fixed-size types, constant-bounded loops, no recursion - because every program must compile into finite proving circuits; strongly and statically typed unlike TypeScript; compiles to JavaScript plus TypeScript definitions, zkir proving circuits with keys, and a JSON contract-info file."}, {"id": "references_ch12_ref_39_compact_language_reference_circuit", "label": "Compact circuits (operational core functions)", "file_type": "concept", "source_file": "references/ch12/ref-39-compact-language-reference.md", "source_location": null, "source_url": "https://docs.midnight.network/compact/reference/compact-reference", "captured_at": "2026-06-12", "author": null, "contributor": null}, {"id": "references_ch12_ref_39_compact_language_reference_witness", "label": "Compact witnesses (private-state callbacks)", "file_type": "concept", "source_file": "references/ch12/ref-39-compact-language-reference.md", "source_location": null, "source_url": "https://docs.midnight.network/compact/reference/compact-reference", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "Witness implementations are supplied by the TypeScript DApp, so a contract must never assume the code is its own: witness results are untrusted input."}, {"id": "references_ch12_ref_39_compact_language_reference_ledger_declarations", "label": "Ledger declarations (public state)", "file_type": "concept", "source_file": "references/ch12/ref-39-compact-language-reference.md", "source_location": null, "source_url": "https://docs.midnight.network/compact/reference/compact-reference", "captured_at": "2026-06-12", "author": null, "contributor": null}, {"id": "references_ch12_ref_39_compact_language_reference_explicit_disclosure", "label": "Explicit disclosure / disclose() wrapper", "file_type": "rationale", "source_file": "references/ch12/ref-39-compact-language-reference.md", "source_location": null, "source_url": "https://docs.midnight.network/compact/reference/compact-reference", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "Privacy is the default and disclosure the exception: any witness-derived data flowing to public state or exported returns must be wrapped in disclose(); the wrapper causes no disclosure itself, only acknowledges it, and should be placed after obfuscation such as hashing."}, {"id": "references_ch12_ref_39_compact_language_reference_zkir", "label": "zkir (zero-knowledge intermediate representation)", "file_type": "concept", "source_file": "references/ch12/ref-39-compact-language-reference.md", "source_location": null, "source_url": "https://docs.midnight.network/compact/reference/compact-reference", "captured_at": "2026-06-12", "author": null, "contributor": null}, {"id": "references_ch12_ref_39_compact_language_reference_typescript_target", "label": "TypeScript/JavaScript compilation target", "file_type": "concept", "source_file": "references/ch12/ref-39-compact-language-reference.md", "source_location": null, "source_url": "https://docs.midnight.network/compact/reference/compact-reference", "captured_at": "2026-06-12", "author": null, "contributor": null}], "edges": [{"source": "references_ch12_ref_39_compact_language_reference_compact_language", "target": "references_ch12_ref_39_compact_language_reference_zkir", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch12/ref-39-compact-language-reference.md", "source_location": null, "weight": 1.0}, {"source": "references_ch12_ref_39_compact_language_reference_compact_language",