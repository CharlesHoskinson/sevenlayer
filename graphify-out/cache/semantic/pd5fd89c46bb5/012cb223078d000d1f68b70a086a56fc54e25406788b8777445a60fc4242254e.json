{"nodes": [{"id": "references_ch06_ref_22_frozen_heart_frozen_heart_vulnerability", "label": "Frozen Heart vulnerability class", "file_type": "rationale", "source_file": "references/ch06/ref-22-frozen-heart.md", "source_location": null, "source_url": "https://blog.trailofbits.com/2022/04/13/part-1-coordinated-disclosure-of-vulnerabilities-affecting-girault-bulletproofs-and-plonk/", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "Proof forgeries caused by insecure Fiat-Shamir implementations; pervasive because academic papers present only interactive protocols, describe transcripts ambiguously, and give no implementation guidance. Remedies: hash all public statement values and commitments, better guidance (ZKDocs), test vectors, code audits."}, {"id": "references_ch06_ref_22_frozen_heart_fiat_shamir_transformation", "label": "Fiat-Shamir transformation", "file_type": "concept", "source_file": "references/ch06/ref-22-frozen-heart.md", "source_location": null, "source_url": "https://blog.trailofbits.com/2022/04/13/part-1-coordinated-disclosure-of-vulnerabilities-affecting-girault-bulletproofs-and-plonk/", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "Hash computation must include all public values from the proof statement and all public commitment values; omitting them enables proof forgery."}, {"id": "references_ch06_ref_22_frozen_heart_bulletproofs", "label": "Bulletproofs (proof system)", "file_type": "concept", "source_file": "references/ch06/ref-22-frozen-heart.md", "source_location": null, "source_url": "https://blog.trailofbits.com/2022/04/13/part-1-coordinated-disclosure-of-vulnerabilities-affecting-girault-bulletproofs-and-plonk/", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "Original academic paper recommended an insecure Fiat-Shamir generation, later fixed after Trail of Bits disclosure."}, {"id": "references_ch06_ref_22_frozen_heart_plonk", "label": "PlonK (proof system)", "file_type": "concept", "source_file": "references/ch06/ref-22-frozen-heart.md", "source_location": null, "source_url": "https://blog.trailofbits.com/2022/04/13/part-1-coordinated-disclosure-of-vulnerabilities-affecting-girault-bulletproofs-and-plonk/", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "Paper never explicitly defines how to hash the transcript, so several implementations computed Fiat-Shamir incorrectly."}, {"id": "references_ch06_ref_22_frozen_heart_schnorr_proof_system", "label": "Schnorr proof system", "file_type": "concept", "source_file": "references/ch06/ref-22-frozen-heart.md", "source_location": null, "source_url": "https://blog.trailofbits.com/2022/04/13/part-1-coordinated-disclosure-of-vulnerabilities-affecting-girault-bulletproofs-and-plonk/", "captured_at": "2026-06-12", "author": null, "contributor": null}, {"id": "references_ch06_ref_22_frozen_heart_girault_proof_of_knowledge", "label": "Girault proof of knowledge", "file_type": "concept", "source_file": "references/ch06/ref-22-frozen-heart.md", "source_location": null, "source_url": "https://blog.trailofbits.com/2022/04/13/part-1-coordinated-disclosure-of-vulnerabilities-affecting-girault-bulletproofs-and-plonk/", "captured_at": "2026-06-12", "author": null, "contributor": null}, {"id": "references_ch06_ref_22_frozen_heart_zkdocs", "label": "ZKDocs", "file_type": "concept", "source_file": "references/ch06/ref-22-frozen-heart.md", "source_location": null, "source_url": "https://blog.trailofbits.com/2022/04/13/part-1-coordinated-disclosure-of-vulnerabilities-affecting-girault-bulletproofs-and-plonk/", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "Created by Trail of Bits to give clearer implementation guidance for protocol areas commonly gotten wrong, especially Fiat-Shamir."}, {"id": "references_ch06_ref_22_frozen_heart_trail_of_bits", "label": "Trail of Bits", "file_type": "concept", "source_file": "referen