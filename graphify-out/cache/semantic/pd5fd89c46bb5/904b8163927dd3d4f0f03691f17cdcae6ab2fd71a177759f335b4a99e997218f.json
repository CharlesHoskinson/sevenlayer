{"nodes": [{"id": "references_snowball_hop2_ref_162_doi_10_1007_s10623_014_9938_4_module_lattice_reductions", "label": "Langlois-Stehl\u00e9, Worst-Case to Average-Case Reductions for Module Lattices (Des. Codes Cryptogr. 2015)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-162-doi-10-1007-s10623-014-9938-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Defines Module-SIS and Module-LWE, bridging SIS with Ring-SIS and LWE with Ring-LWE, and proves them at least as hard as worst-case problems on module lattices; unlike the ring setting the reductions are qualitatively sharp (converse reductions exist)."}, {"id": "references_snowball_hop2_ref_162_doi_10_1007_s10623_014_9938_4_adeline_langlois", "label": "Adeline Langlois", "file_type": "concept", "source_file": "references/snowball/hop2/ref-162-doi-10-1007-s10623-014-9938-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_162_doi_10_1007_s10623_014_9938_4_damien_stehle", "label": "Damien Stehl\u00e9", "file_type": "concept", "source_file": "references/snowball/hop2/ref-162-doi-10-1007-s10623-014-9938-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_162_doi_10_1007_s10623_014_9938_4_module_lwe", "label": "Module-LWE", "file_type": "concept", "source_file": "references/snowball/hop2/ref-162-doi-10-1007-s10623-014-9938-4.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Average-case problem interpolating between LWE and Ring-LWE; enlarges the lattice cryptographer's toolbox with a tunable structure/security trade-off."}, {"id": "references_snowball_hop2_ref_162_doi_10_1007_s10623_014_9938_4_module_lattices", "label": "Module Lattices", "file_type": "conce