{"nodes": [{"id": "references_mooc_lecture01_transcript_interactive_proof", "label": "Interactive proof", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adds interaction and verifier randomness to NP verification; accepts a quantified negligible soundness error because an event with probability ~2^-k never happens in the lifetime of the universe; IP with a powerful prover reaches all of PSPACE."}, {"id": "references_mooc_lecture01_transcript_zero_knowledge", "label": "Zero-knowledge property", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The verifier learns nothing beyond truth of the claim: whatever it can compute after the interaction it could already compute before, for every (even malicious) verifier; flavors: computational, statistical, perfect."}, {"id": "references_mooc_lecture01_transcript_simulation_paradigm", "label": "Simulation paradigm", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A view gives nothing new if an expected-polynomial-time simulator, given only the input, produces a distribution computationally indistinguishable from the real interaction."}, {"id": "references_mooc_lecture01_transcript_computational_indistinguishability", "label": "Computational indistinguishability", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture01_transcript_proof_of_knowledge", "label": "Proof of knowledge / knowledge extractor", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A machine knows a witness if an extractor that can rewind and rerun the prover outputs the witness in expected polynomial time - the rewinding technique."}, {"id": "references_mooc_lecture01_transcript_commitment_scheme", "label": "Commitment scheme (hiding and binding)", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture01_transcript_gmw_theorem", "label": "GMW theorem (if one-way functions exist, every NP language has a computational ZK interactive proof)", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proved via an NP-complete problem: a zero-knowledge protocol for graph 3-coloring plus NP reductions extends zero knowledge to all of NP."}, {"id": "references_mooc_lecture01_transcript_one_way_functions", "label": "One-way functions", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture01_transcript_graph_three_coloring_protocol", "label": "Graph 3-coloring ZK protocol (random color permutation + commitments)", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture01_transcript_quadratic_residue_protocol", "label": "Quadratic residuosity ZK protocol", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture01_transcript_graph_isomorphism_protocol", "label": "Graph isomorphism ZK protocol", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture01_transcript_fiat_shamir_paradigm", "label": "Fiat-Shamir paradigm (hash replaces public-coin verifier)", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Heuristic in the random-oracle model: the prover hashes its own messages to derive the verifier's coins, removing interaction for public-coin protocols; first message coins can be posted as public randomness."}, {"id": "references_mooc_lecture01_transcript_arthur_merlin_games", "label": "Arthur-Merlin games (public-coin proofs, Babai-Moran)", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture01_transcript_ip_pspace_theorem", "label": "IP = PSPACE (Lund-Fortnow-Karloff-Nisan, Shamir)", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture01_transcript_multi_prover_interactive_proofs", "label": "Multi-prover interactive proofs (MIP)", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Two isolated provers let the verifier catch inconsistencies, yielding unconditional perfect ZK for NP and reaching NEXP."}, {"id": "references_mooc_lecture01_transcript_pcp_theorem", "label": "PCP theorem (verify NP proofs reading a constant number of bits)", "file_type": "concept", "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_mooc_lecture01_transcript_zero_knowledge", "target": "references_mooc_lecture01_transcript_interactive_proof", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture01_transcript_simulation_paradigm", "target": "references_mooc_lecture01_transcript_zero_knowledge", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture01_transcript_simulation_paradigm", "target": "references_mooc_lecture01_transcript_computational_indistinguishability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture01_transcript_proof_of_knowledge", "target": "references_mooc_lecture01_transcript_zero_knowledge", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture01_transcript_proof_of_knowledge", "target": "references_mooc_lecture01_transcript_quadratic_residue_protocol", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture01/transcript.txt", "source_location": null, "weight": 1.0},