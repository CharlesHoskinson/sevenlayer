{"nodes": [{"id": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_doc", "label": "lean Ethereum (EF Blog)", "file_type": "document", "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/31/lean-ethereum", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_lean_ethereum", "label": "Lean Ethereum", "file_type": "rationale", "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/31/lean-ethereum", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Vision for Ethereum's next decade: marry extreme performance (beast mode: gigagas L1, teragas L2) with survivability against nation states and quantum computers (fort mode), with next-generation cryptography as the unified answer to both."}, {"id": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_hash_based_cryptography", "label": "Hash-Based Cryptography", "file_type": "rationale", "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/31/lean-ethereum", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Chosen as the leanest cryptographic foundation because it answers two megatrends at once: the explosive rise of SNARKs and the looming quantum threat. One primitive (the hash function) powers consensus, data, and execution layers."}, {"id": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_hash_based_aggregate_signatures", "label": "Hash-Based Aggregate Signatures", "file_type": "rationale", "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/31/lean-ethereum", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Post-quantum upgrade path for the consensus layer: hash-based aggregate signatures replace BLS signatures."}, {"id": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_lean_consensus", "label": "Lean Consensus (Beacon Chain 2.0)", "file_type": "concept", "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/31/lean-ethereum", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_lean_data", "label": "Lean Data (Blobs 2.0)", "file_type": "concept", "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/31/lean-ethereum", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_lean_execution", "label": "Lean Execution (EVM 2.0)", "file_type": "concept", "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/31/lean-ethereum", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "A minimal, SNARK-friendly instruction set (possibly RISC-V) boosts performance while preserving EVM compatibility and its network effects."}, {"id": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_real_time_zkvms", "label": "Real-Time zkVMs", "file_type": "rationale", "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/31/lean-ethereum", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Real-time zkVMs replace EVM re-execution for lean execution, enabling full chain verification in every browser, wallet, and phone."}, {"id": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_data_availability_sampling", "label": "Data Availability Sampling (DAS)", "file_type": "rationale", "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/31/lean-ethereum", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_justin_drake", "label": "Justin Drake", "file_type": "concept", "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/31/lean-ethereum", "captured_at": "2026-06-13", "author": null, "contributor": null}], "edges": [{"source": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_doc", "target": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_lean_ethereum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_doc", "target": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_hash_based_cryptography", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch1/ref-37-ethereum-lean-hash-based-sig-aggregation.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch1_ref_37_ethereum_lean_hash_based_sig_aggregation_