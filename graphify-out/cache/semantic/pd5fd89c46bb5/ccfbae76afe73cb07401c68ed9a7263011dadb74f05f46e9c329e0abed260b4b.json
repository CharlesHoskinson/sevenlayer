{"nodes": [{"id": "references_snowball_recursion_ref_145_practical_product_proofs_for_lattice_commitments", "label": "Practical Product Proofs for Lattice Commitments", "file_type": "paper", "source_file": "references/snowball/recursion/ref-145-practical-product-proofs-for-lattice-commitments.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "thomas_attema", "label": "Thomas Attema", "file_type": "concept", "source_file": "references/snowball/recursion/ref-145-practical-product-proofs-for-lattice-commitments.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "product_proof", "label": "Multiplicative Relation Proof for Lattice Commitments", "file_type": "concept", "rationale": "Deriving message maskings from the randomness masking already committed to via w lets the verifier recompute masked openings instead of receiving them, so the multiplicative proof (9KB) costs only slightly more than the bare opening proof (7KB).", "source_file": "references/snowball/recursion/ref-145-practical-product-proofs-for-lattice-commitments.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ntt_packing", "label": "NTT Coefficient Packing", "file_type": "rationale", "rationale": "Choosing q so X^d+1 splits into low-degree factors lets many Zq values be packed into NTT slots and multiplied component-wise, powering range proofs (5.9KB for 32-bit ranges); the paper removes the earlier restriction that challenge differences be invertible by analyzing the min-entropy of challenges per NTT slot.", "source_file": "references/snowball/recursion/ref-145-practical-product-proofs-for-lattice-commitments.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "rejection_sampling", "label": "Rejection Sampling (Fiat-Shamir with Aborts)", "file_type": "rationale", "rationale": "Standard rejection sampling makes the prover's masked response independent of the secret randomness, preserving zero-knowledge in lattice Sigma-protocols at the cost of occasional protocol restarts.", "source_file": "references/snowball/recursion/ref-145-practical-product-proofs-for-lattice-commitments.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_snowball_recursion_ref_145_practical_product_proofs_for_lattice_commitments", "target": "thomas_attema", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/recursion/ref-145-practical-product-proofs-for-lattice-commitments.pdf", "source_location": null, "weight": 1.0}, {"source": "references_snowball_recursion_ref_145_practical_product_proofs_for_lattice_commitments", "target": "vadim_lyubashevsky", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/recursion/ref-145-practical-product-proofs-for-lattice-commitments.pdf", "source_location": null, "weight": 1.0}, {"source": "references_snowball_recursion_ref_145_practical_product_proofs_for_lattice_commitments", "target": "gregor_seiler", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/recursion/ref-145-practical-product-proofs-for-lattice-commitments.pdf", "source_location": null, "weight": 1.0}, {"source": "references_snowball_recursion_ref_145_practical_product_proofs_for_lattice_commitments", "target": "product_proof", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/recursion/ref-145-practical-product-proofs-for-lattice-commitments.pdf", "source_location": null, "weight": 1.0}, {"source": "references_snowball_recursion_ref_145_practical_product_proofs_for_lattice_commitments