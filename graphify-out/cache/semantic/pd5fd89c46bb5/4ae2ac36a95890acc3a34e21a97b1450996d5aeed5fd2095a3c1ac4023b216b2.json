{"nodes": [{"id": "references_snowball_hop2_ref_157_doi_10_1007_978_3_031_38545_2_7_brakedown", "label": "Golovnev-Lee-Setty-Thaler-Wahby, Brakedown: Linear-Time and Field-Agnostic SNARKs for R1CS (CRYPTO 2023)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-157-doi-10-1007-978-3-031-38545-2-7.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First built SNARK with a linear-time O(N) prover for R1CS; no trusted setup, plausibly post-quantum, and compatible with arbitrary sufficiently large finite fields. Obtained by combining the BCG (TCC 2020) polynomial commitment with Spartan's linear-time interactive proof."}, {"id": "references_snowball_hop2_ref_157_doi_10_1007_978_3_031_38545_2_7_alexander_golovnev", "label": "Alexander Golovnev", "file_type": "concept", "source_file": "references/snowball/hop2/ref-157-doi-10-1007-978-3-031-38545-2-7.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_157_doi_10_1007_978_3_031_38545_2_7_srinath_setty", "label": "Srinath Setty", "file_type": "concept", "source_file": "references/snowball/hop2/ref-157-doi-10-1007-978-3-031-38545-2-7.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_157_doi_10_1007_978_3_031_38545_2_7_justin_thaler", "label": "Justin Thaler", "file_type": "concept", "source_file": "references/snowball/hop2/ref-157-doi-10-1007-978-3-031-38545-2-7.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_157_doi_10_1007_978_3_031_38545_2_7_riad_wahby", "label": "Riad S. Wahby", "file_type": "concept", "source_file": "references/snowball/hop2/ref-157-doi-10-1007-978-3-031-38545-2-7.html", "source_location": null, "source_url": null, "captured_a