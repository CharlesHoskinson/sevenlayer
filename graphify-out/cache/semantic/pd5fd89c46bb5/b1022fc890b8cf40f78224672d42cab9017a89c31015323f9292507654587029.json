{"nodes": [{"id": "references_recursion_ch1_ref_22_nebra_upa", "label": "NEBRA: Universal Proof Aggregation (UPA)", "file_type": "document", "source_file": "references/recursion/ch1/ref-22-nebra-upa.md", "source_location": null, "source_url": "https://docs.nebra.one/", "captured_at": "2026-06-13", "author": "NEBRA", "contributor": null}, {"id": "references_recursion_ch1_ref_22_nebra_upa_universal_proof_aggregation", "label": "Universal Proof Aggregation", "file_type": "rationale", "source_file": "references/recursion/ch1/ref-22-nebra-upa.md", "source_location": null, "source_url": "https://docs.nebra.one/", "captured_at": "2026-06-13", "author": "NEBRA", "contributor": null, "rationale": "On-chain verification is prohibitively expensive (Groth16 ~250k gas / $22.5, Halo2-KZG ~400k, STARK-FRI ~1.5M / $105), excluding most users; highly efficient recursive SNARKs (IVCs/PCDs) give near-unlimited recursion almost for free, so proofs from different circuits, proof systems and parties aggregate off-chain into one on-chain proof."}], "edges": [{"source": "references_recursion_ch1_ref_22_nebra_upa", "target": "references_recursion_ch1_ref_22_nebra_upa_universal_proof_aggregation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch1/ref-22-nebra-upa.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch1_ref_22_nebra_upa_universal_proof_aggregation", "target": "references_mooc_lecture10_transcript_incrementally_verifiable_computation", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "references/recursion/ch1/ref-22-nebra-upa.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch1_ref_22_nebra_upa_universal_proof_aggregation", "target": "references_recursion_ch1_ref_04_chiesa_tromer_pcd_hearsay", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "references/r