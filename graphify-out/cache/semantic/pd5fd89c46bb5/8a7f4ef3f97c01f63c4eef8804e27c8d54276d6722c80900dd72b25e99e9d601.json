{"nodes": [{"id": "references_recursion_ch3_ref_88_provisions", "label": "Provisions: Privacy-Preserving Proofs of Solvency for Bitcoin Exchanges", "file_type": "paper", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "Gaby G. Dagher, Benedikt Bunz, Joseph Bonneau, Jeremy Clark, Dan Boneh", "contributor": null}, {"id": "benedikt_bunz", "label": "Benedikt Bunz", "file_type": "concept", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dan_boneh", "label": "Dan Boneh", "file_type": "concept", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "joseph_bonneau", "label": "Joseph Bonneau", "file_type": "concept", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "proof_of_solvency", "label": "Proof of Solvency", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "After Mt. Gox-style collapses, exchanges need periodic demonstrations of reserves, but public proofs leak addresses and business size; Provisions keeps customer balances, total holdings, and Bitcoin addresses secret, and deliberately avoids SNARK trusted setup to stay palatable to the Bitcoin community."}, {"id": "proof_of_liabilities", "label": "Proof of Liabilities", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "proof_of_assets", "label": "Proof of Assets", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pedersen_commitment", "label": "Pedersen Commitment", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "maxwell_proof_of_liabilities", "label": "Maxwell Proof of Liabilities", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Maxwell's Merkle-tree protocol lets users verify inclusion of their balance but publishes total liabilities in the root and leaks sibling balances; these leaks motivated Provisions' fully private design."}, {"id": "merkle_tree", "label": "Merkle Tree", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "bitcoin", "label": "Bitcoin", "file_type": "concept", "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_recursion_ch3_ref_88_provisions", "target": "benedikt_bunz", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_88_provisions", "target": "dan_boneh", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-88-provisions.pdf", "source_location": null, "weight": 1