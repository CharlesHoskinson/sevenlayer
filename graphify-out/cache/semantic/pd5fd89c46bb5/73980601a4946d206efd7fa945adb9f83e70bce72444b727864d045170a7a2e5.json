{"nodes": [{"id": "updatable_srs", "label": "Updatable Universal Structured Reference String", "file_type": "rationale", "source_file": "references/ch10/ref-37-updatable-universal-crs.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An updatable SRS lets an open, dynamic set of participants contribute secret randomness indefinitely; security holds if any single updater was honest, mitigating trusted-setup risk without discarding SNARK efficiency, and a universal SRS removes per-circuit re-setup."}, {"id": "references_ch10_ref_37_updatable_universal_crs", "label": "Updatable and Universal Common Reference Strings with Applications to zk-SNARKs", "file_type": "paper", "source_file": "references/ch10/ref-37-updatable-universal-crs.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "jens_groth", "label": "Jens Groth", "file_type": "concept", "source_file": "references/ch10/ref-37-updatable-universal-crs.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ian_miers", "label": "Ian Miers", "file_type": "concept", "source_file": "references/ch10/ref-37-updatable-universal-crs.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "quadratic_arithmetic_program", "label": "Quadratic Arithmetic Program (QAP)", "file_type": "concept", "source_file": "references/ch10/ref-37-updatable-universal-crs.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "zk_snark", "label": "zk-SNARK", "file_type": "concept", "source_file": "references/ch10/ref-37-updatable-universal-crs.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "subversion_zero_knowledge", "label": "Subversion Zero-Knowledge", "fil