{"nodes": [{"id": "references_snowball_recursion_ref_149_a_compressed_sigma_protocol_theory_for_lattices", "label": "A Compressed Sigma-Protocol Theory for Lattices", "file_type": "paper", "source_file": "references/snowball/recursion/ref-149-a-compressed-sigma-protocol-theory-for-lattices.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ronald_cramer", "label": "Ronald Cramer", "file_type": "concept", "source_file": "references/snowball/recursion/ref-149-a-compressed-sigma-protocol-theory-for-lattices.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "lisa_kohl", "label": "Lisa Kohl", "file_type": "concept", "source_file": "references/snowball/recursion/ref-149-a-compressed-sigma-protocol-theory-for-lattices.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "compressed_sigma_protocols", "label": "Compressed Sigma-Protocol Theory", "file_type": "concept", "source_file": "references/snowball/recursion/ref-149-a-compressed-sigma-protocol-theory-for-lattices.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "special_soundness", "label": "(k1,...,kmu)-Special Soundness", "file_type": "concept", "rationale": "The paper tightly proves that multi-round special soundness implies knowledge soundness even with poly-small challenge spaces, modeling the extractor by a negative hypergeometric distribution; this closes the gap that lattice Bulletproof-style protocols had overlooked.", "source_file": "references/snowball/recursion/ref-149-a-compressed-sigma-protocol-theory-for-lattices.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "parallel_repetition", "label": "Parallel Repetition for Knowledge Error Reduction", "file_type": "rationale", "ratio