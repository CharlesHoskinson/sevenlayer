{"nodes": [{"id": "references_recursion_ch2_ref_43_nova_implementation_doc", "label": "Nova Reference Implementation (microsoft/Nova)", "file_type": "document", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch2_ref_43_nova_implementation_nova", "label": "Nova", "file_type": "concept", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Simplest recursive proof system in the literature yet fastest prover, with a constant-sized verifier circuit of about 10,000 multiplication gates. Maintainers deliberately prioritize code simplicity over minor performance gains to keep auditing for correctness and security tractable."}, {"id": "references_recursion_ch2_ref_43_nova_implementation_incrementally_verifiable_computation", "label": "Incrementally Verifiable Computation (IVC)", "file_type": "rationale", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Prover updates proof pi_i to pi_i+1 with work independent of the number of steps executed so far, and verifier work does not grow with computation length. Enables rollups, VDFs, succinct blockchains, verifiable state machines, and proofs of (virtual) machine executions such as EVM and RISC-V."}, {"id": "references_recursion_ch2_ref_43_nova_implementation_folding_scheme", "label": "Folding Scheme", "file_type": "rationale", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Reduces the task of checking two NP statements to checking a single NP statement - the simple primitive from which Nova's recursion is built."}, {"id": "references_recursion_ch2_ref_43_nova_implementation_spartan", "label": "Spartan", "file_type": "concept", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch2_ref_43_nova_implementation_microspartan", "label": "MicroSpartan", "file_type": "concept", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Preprocessing variant of Spartan ensuring the verifier's run time does not depend on the size of the step circuit."}, {"id": "references_recursion_ch2_ref_43_nova_implementation_hypernova", "label": "HyperNova", "file_type": "concept", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Nova's zero-knowledge property is achieved by folding the IVC proof with a random instance prior to compression, an idea described in the HyperNova paper."}, {"id": "references_recursion_ch2_ref_43_nova_implementation_micronova", "label": "MicroNova", "file_type": "concept", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch2_ref_43_nova_implementation_neutronnova", "label": "NeutronNova", "file_type": "concept", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch2_ref_43_nova_implementation_pedersen_ipa_commitments", "label": "Pedersen Commitments with IPA Evaluation", "file_type": "concept", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch2_ref_43_nova_implementation_hyperkzg", "label": "HyperKZG Commitment Scheme", "file_type": "concept", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch2_ref_43_nova_implementation_mercury", "label": "Mercury Commitment Scheme", "file_type": "concept", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Optimized variant providing faster verification than HyperKZG on pairing-friendly curves."}, {"id": "references_recursion_ch2_ref_43_nova_implementation_curve_cycle", "label": "Cycle of Elliptic Curves", "file_type": "rationale", "source_file": "references/recursion/ch2/ref-43-nova-implementation.md", "source_location": null, "source_url": "https://github.com/microsoft/Nova", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "For efficiency Nova is instantiated over a cycle of curves (Pallas/Vesta, BN254/Grumpkin, secp/secq); the instantiation has its own security proof (IACR ePrint 2023/969)."}, {"id": "references_recursion_ch2_ref_43_nova_implementation_powers_of_tau", "label": "