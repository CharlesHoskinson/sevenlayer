{"nodes": [{"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_paper", "label": "An Empirical Analysis of Traceability in the Monero Blockchain", "file_type": "paper", "source_file": "references/snowball/hop2/ref-286-arxiv-1704-04299.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_malte_moser", "label": "Malte Moser", "file_type": "concept", "source_file": "references/snowball/hop2/ref-286-arxiv-1704-04299.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_andrew_miller", "label": "Andrew Miller", "file_type": "concept", "source_file": "references/snowball/hop2/ref-286-arxiv-1704-04299.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_arvind_narayanan", "label": "Arvind Narayanan", "file_type": "concept", "source_file": "references/snowball/hop2/ref-286-arxiv-1704-04299.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_monero_mixin_sampling", "label": "Monero Mixin Sampling Strategy", "file_type": "concept", "source_file": "references/snowball/hop2/ref-286-arxiv-1704-04299.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Mixins sampled from a distribution unlike real spending behavior: the real input is the newest referenced output ~92% of the time among deducible inputs, enabling ~80% guessing accuracy overall."}, {"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_chain_reaction_analysis", "label": "Chain-Reaction (Deducibility) Analysis", "file_type": "concept", "source_file": "references/snowball/hop2/ref-286-arxiv-1704-04299.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "0-mixin transactions provably spend their outputs, so those outputs can be eliminated as mixins elsewhere by iterated deduction; 62-63% of pre-2017 inputs with mixins are fully deducible."}, {"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_temporal_analysis_attack", "label": "Temporal Analysis of Spend-Time Distributions", "file_type": "concept", "source_file": "references/snowball/hop2/ref-286-arxiv-1704-04299.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_binned_mixin_sampling", "label": "Binned Mixin Sampling Countermeasure", "file_type": "concept", "source_file": "references/snowball/hop2/ref-286-arxiv-1704-04299.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Samples mixins in bins of same-age outputs so all bin members share the same temporal-analysis probability, preserving a guessing-entropy floor even if the sampling distribution is compromised."}, {"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_ringct", "label": "RingCT", "file_type": "concept", "source_file": "references/snowball/hop2/ref-286-arxiv-1704-04299.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_cryptonote_paper", "label": "van Saberhagen, CryptoNote Protocol", "file_type": "paper", "source_file": "references/snowball/hop2/ref-286-arxiv-1704-04299.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_286_arxiv_1704_04299_mrl0001_paper", "label": "Monero Research Lab, MRL-0001: A Note on Chain Reactions in Traceability", "file_type": "paper",