{"nodes": [{"id": "references_mooc_lecture11_transcript", "label": "MOOC Lecture 11: Theoretical Foundations - Fiat-Shamir Without Random Oracles", "file_type": "document", "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Alex Lombardi", "contributor": null}, {"id": "references_mooc_lecture11_transcript_correlation_intractability", "label": "Correlation Intractability", "file_type": "rationale", "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Alex Lombardi", "contributor": null, "rationale": "Hard to find x with h(x)=f(x). Impossible for unrestricted input lengths (diagonalization: feed h its own description), so constructions bound input length and the running time of f; the FHE/LWE construction hides a trap function g* = Dec(f(x))+1 inside the hash key. Suffices to instantiate Fiat-Shamir for statistically (round-by-round) sound protocols by making bad challenges unreachable."}, {"id": "references_mooc_lecture11_transcript_random_oracle_model", "label": "Random Oracle Model", "file_type": "rationale", "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Alex Lombardi", "contributor": null, "rationale": "Assumes attacks treat the hash as a black box; provably violated by correlation-intractability diagonalization and by the Barak / Goldwasser-Kalai protocols where Fiat-Shamir is ROM-secure yet insecure for every concrete hash. Recursive SNARKs run the hash on (something like) its own description, so the secure/insecure line is genuinely unclear."}, {"id": "references_mooc_lecture11_transcript_falsifiable_assumptions", "label": "Falsifiable Assumptions", "file_type": "concept", "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Alex Lombardi", "contributor": null, "rationale": "Concrete algorithmic hardness (discrete log, LWE, SHA collision resistance). SNARKs with knowledge soundness resist falsifiable-assumption constructions because a short proof cannot obviously yield a long witness; SNARGs for subclasses (batch NP, deterministic computation) are achievable."}, {"id": "references_mooc_lecture11_transcript_fully_homomorphic_encryption", "label": "Fully Homomorphic Encryption", "file_type": "concept", "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Alex Lombardi", "contributor": null}, {"id": "references_mooc_lecture11_transcript_learning_with_errors", "label": "Learning With Errors (LWE)", "file_type": "concept", "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Alex Lombardi", "contributor": null}, {"id": "references_mooc_lecture11_transcript_somewhere_statistically_binding_commitment", "label": "Somewhere Statistically Binding Commitment", "file_type": "rationale", "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Alex Lombardi", "contributor": null, "rationale": "Hash key can be sampled to statistically bind one hidden coordinate of the committed vector, and the modes are indistinguishable; makes the batch-NP protocol statistically sound on any single false statement, which is exactly the hook correlation intractability needs."}, {"id": "references_mooc_lecture11_transcript_batch_np_snarg", "label": "SNARG for Batch NP (Choudhuri-Jain-Jin)", "file_type": "concept", "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Alex Lombardi", "contributor": null, "rationale": "Proves k NP statements with proof size polylog in k (but >= one witness); powerful enough to yield SNARGs for all deterministic computations."}, {"id": "references_mooc_lecture11_transcript_kilian_micali_construction", "label": "Kilian-Micali PCP-Based Succinct Argument", "file_type": "concept", "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Alex Lombardi", "contributor": null}, {"id": "references_mooc_lecture11_transcript_parallel_repetition", "label": "Parallel Repetition of ZK Protocols", "file_type": "concept", "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Alex Lombardi", "contributor": null, "rationale": "Reduces soundness error for statistically sound protocols but does not preserve zero knowledge: Dwork-Naor-Reingold-Stockmeyer show either Fiat-Shamir fails for the repeated 3-coloring protocol or the protocol is not ZK against malicious verifiers."}], "edges": [{"source": "references_mooc_lecture11_transcript", "target": "references_mooc_lecture11_transcript_correlation_intractability", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript", "target": "references_mooc_lecture11_transcript_random_oracle_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript", "target": "references_mooc_lecture11_transcript_falsifiable_assumptions", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript", "target": "references_mooc_lecture11_transcript_fully_homomorphic_encryption", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript", "target": "references_mooc_lecture11_transcript_learning_with_errors", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript", "target": "references_mooc_lecture11_transcript_somewhere_statistically_binding_commitment", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript", "target": "references_mooc_lecture11_transcript_batch_np_snarg", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript", "target": "references_mooc_lecture11_transcript_kilian_micali_construction", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript", "target": "references_mooc_lecture11_transcript_parallel_repetition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript_correlation_intractability", "target": "references_mooc_lecture11_transcript_random_oracle_model", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture11/tran