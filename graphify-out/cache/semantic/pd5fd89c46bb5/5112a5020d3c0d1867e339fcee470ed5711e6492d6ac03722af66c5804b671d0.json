", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript_correlation_intractability", "target": "references_mooc_lecture08_transcript_fiat_shamir_transformation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript_parallel_repetition", "target": "references_mooc_lecture08_transcript_fiat_shamir_transformation", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture11_transcript", "target": "references_mooc_lecture10_transcript_recursive_snark", "relation": "references", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "references/mooc/lecture11/transcript.txt", "source_location": null, "weight": 1.0}], "hyperedges": []}