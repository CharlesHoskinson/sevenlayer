{"nodes": [{"id": "references_snowball_book_ref_085_libsnark", "label": "libsnark zkSNARK Library", "file_type": "document", "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "source_url": "https://github.com/scipr-lab/libsnark", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Research-quality C++ zkSNARK library by SCIPR Lab; explicitly not production-ready, with known timing/cache side channels and /dev/urandom randomness caveats."}, {"id": "references_snowball_book_ref_085_libsnark_zksnark", "label": "zkSNARK", "file_type": "concept", "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "source_url": "https://github.com/scipr-lab/libsnark", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Zero-Knowledge Succinct Non-interactive ARgument of Knowledge: zero knowledge, succinctness, non-interactivity, computational soundness, and proof of knowledge; also described as succinct non-interactive computationally-sound zero-knowledge proofs of knowledge."}, {"id": "references_snowball_book_ref_085_libsnark_r1cs", "label": "Rank-1 Constraint System (R1CS)", "file_type": "concept", "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "source_url": "https://github.com/scipr-lab/libsnark", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "NP-complete language of equations <A,(1,X)>*<B,(1,X)>=<C,(1,X)> over a prime field; arithmetic and boolean circuits reduce to it gate-by-gate, making it the common target language for SNARK frontends."}, {"id": "references_snowball_book_ref_085_libsnark_ppzksnark", "label": "Preprocessing zkSNARK (ppzkSNARK)", "file_type": "concept", "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "source_url": "https://github.com/scipr-lab/libsnark", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Requires a circuit-specific generator run once to produce a long proving key and short verification key before any proofs can be created or verified; follows and optimizes BCTV14a, itself building on BCGTV13, GGPR13, and BCIOP13."}, {"id": "references_snowball_book_ref_085_libsnark_proof_carrying_data", "label": "Proof-Carrying Data (PCD)", "file_type": "concept", "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "source_url": "https://github.com/scipr-lab/libsnark", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Implemented via recursive composition of SNARKs as explained in BCCT13 and optimized in BCTV14b using cycles of elliptic curves; enables scalable TinyRAM proving and zero-knowledge cluster MapReduce (CTV15)."}, {"id": "references_snowball_book_ref_085_libsnark_recursive_composition", "label": "Recursive Composition of SNARKs", "file_type": "rationale", "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "source_url": "https://github.com/scipr-lab/libsnark", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Verifying one SNARK inside another so proofs can attest to arbitrarily long or distributed computations; the mechanism underlying PCD and bootstrapping (BCCT13, BCTV14b)."}, {"id": "references_snowball_book_ref_085_libsnark_gadgetlib1", "label": "gadgetlib1", "file_type": "concept", "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "source_url": "https://github.com/scipr-lab/libsnark", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Low-level template-based gadget library exposing all ppzkSNARK features and supporting multiple elliptic curves simultaneously; used for most internal constraint building including reductions and PCD."}, {"id": "references_snowball_book_ref_085_libsnark_gadgetlib2", "label": "gadgetlib2", "file_type": "concept", "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "source_url": "https://github.com/scipr-lab/libsnark", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Alternative gadget library chosen to be better documented and easier to use with a template-free interface, at the cost of providing fewer useful gadgets than gadgetlib1."}, {"id": "references_snowball_book_ref_085_libsnark_tinyram", "label": "TinyRAM", "file_type": "concept", "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "source_url": "https://github.com/scipr-lab/libsnark", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "Random access machine whose code execution (obtainable by compiling from C) is proven with libsnark's proof systems per BCTV14a/BCGTV13; adaptable to any RAM with a simple load-store interface."}, {"id": "references_snowball_book_ref_085_libsnark_groth16", "label": "Groth16 Proof System", "file_type": "concept", "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "source_url": "https://github.com/scipr-lab/libsnark", "captured_at": "2026-06-14", "author": null, "contributor": null, "rationale": "R1CS zk-SNARK secure in the generic group model; faster with shorter proofs than BCTV14a at the expense of stronger security assumptions."}], "edges": [{"source": "references_snowball_book_ref_085_libsnark", "target": "references_snowball_book_ref_085_libsnark_zksnark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "weight": 1.0}, {"source": "references_snowball_book_ref_085_libsnark_ppzksnark", "target": "references_snowball_book_ref_085_libsnark_zksnark", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "weight": 1.0}, {"source": "references_snowball_book_ref_085_libsnark_ppzksnark", "target": "references_snowball_book_ref_085_libsnark_r1cs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "weight": 1.0}, {"source": "references_snowball_book_ref_085_libsnark_gadgetlib1", "target": "references_snowball_book_ref_085_libsnark_r1cs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "weight": 1.0}, {"source": "references_snowball_book_ref_085_libsnark_gadgetlib2", "target": "references_snowball_book_ref_085_libsnark_r1cs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "weight": 1.0}, {"source": "references_snowball_book_ref_085_libsnark_proof_carrying_data", "target": "references_snowball_book_ref_085_libsnark_recursive_composition", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "weight": 1.0}, {"source": "references_snowball_book_ref_085_libsnark", "target": "references_snowball_book_ref_085_libsnark_groth16", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "weight": 1.0}, {"source": "references_snowball_book_ref_085_libsnark_tinyram", "target": "references_snowball_book_ref_085_libsnark_ppzksnark", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/book/ref-085-libsnark.md", "source_location": null, "weight": 1.0}, {"source": "references_snowball_book_ref_085_libsnark_tinyram", "target": "references_snowball_book_ref_085_l