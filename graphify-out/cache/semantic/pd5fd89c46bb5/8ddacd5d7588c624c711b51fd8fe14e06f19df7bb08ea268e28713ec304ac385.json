{"nodes": [{"id": "references_snowball_hop2_ref_153_eprint_2019_762", "label": "Verifiable Computing for Approximate Computation", "file_type": "paper", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "author_shuo_chen", "label": "Shuo Chen", "file_type": "concept", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "author_jung_hee_cheon", "label": "Jung Hee Cheon", "file_type": "concept", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_gkr_protocol", "label": "GKR Protocol", "file_type": "concept", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Chosen over SNARKs because interactive proofs generate proofs roughly 1000x faster, and proof generation cost dominates verifiable computation for heavy workloads such as DNN training."}, {"id": "concept_gkr_over_rings", "label": "Generalized GKR Protocol over Rings", "file_type": "concept", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The algebraic structure is shifted from a field Z_p to the ring Z_p^e because rounding needs a notion of digits; rounded multiplication is many-to-one so the structure cannot remain a field."}, {"id": "concept_verifiable_rounding", "label": "Verifiable Rounding Operation", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rounding is essential for fixed-precision approximate arithmetic in DNN training; exact-only verifiable computing cannot drop insignificant digits and thus misses the AI space."}, {"id": "concept_galois_ring", "label": "Galois Ring Optimization", "file_type": "concept", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replacing Z_p^e by Z_q^de with a much smaller prime q shrinks the rounding polynomial and proof cost; the Galois ring restores the soundness that the smaller base would sacrifice, giving two orders of magnitude speedup at a sweet-spot q."}, {"id": "concept_multilinear_extension", "label": "Multilinear Extension (MLE)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_schwartz_zippel_lemma", "label": "Schwartz-Zippel Lemma", "file_type": "concept", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_sumcheck_protocol", "label": "Sum-Check Protocol", "file_type": "concept", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_verifiable_computation", "label": "Verifiable Computation", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-153-eprint-2019-762.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_snowball_hop2_ref_153_eprint_2019_762", "target": "author_shuo_chen", "relation": "references", "con