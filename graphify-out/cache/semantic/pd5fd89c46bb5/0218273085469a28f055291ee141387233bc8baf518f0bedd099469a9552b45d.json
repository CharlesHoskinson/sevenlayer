{"nodes": [{"id": "references_snowball_hop2_ref_171_eprint_2022_1758", "label": "SuperNova: Proving Universal Machine Executions without Universal Circuits", "file_type": "paper", "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "author_abhiram_kothapalli", "label": "Abhiram Kothapalli", "file_type": "concept", "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "author_srinath_setty", "label": "Srinath Setty", "file_type": "concept", "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_nova", "label": "Nova", "file_type": "concept", "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Folds N circuit-satisfiability instances into one and proves only the folded instance, yielding at least an order of magnitude lower resource cost than proving N steps directly."}, {"id": "concept_supernova", "label": "SuperNova", "file_type": "concept", "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Keeps per-step proving cost proportional only to the circuit of the invoked instruction (a-la-carte cost profile), unlike universal-circuit approaches that pay for every supported instruction at every step."}, {"id": "concept_non_uniform_ivc", "label": "Non-Uniform IVC", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generalizes IVC to a collection of functions with a per-step selector function, formalizing the a-la-carte cost profile for machines with arbitrary instruction sets."}, {"id": "concept_universal_circuit", "label": "Universal Circuit", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prior machine-execution provers pay proving cost proportional to the whole universal circuit even though each step invokes one instruction, motivating minimal instruction sets and, in SuperNova, their elimination."}], "edges": [{"source": "references_snowball_hop2_ref_171_eprint_2022_1758", "target": "author_abhiram_kothapalli", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_171_eprint_2022_1758", "target": "author_srinath_setty", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_171_eprint_2022_1758", "target": "concept_supernova", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_171_eprint_2022_1758", "target": "concept_non_uniform_ivc", "relation": "implements", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-171-eprint-2022-1758.pdf", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_171_eprint_2022_1758", "target": "concept_nova", "relati