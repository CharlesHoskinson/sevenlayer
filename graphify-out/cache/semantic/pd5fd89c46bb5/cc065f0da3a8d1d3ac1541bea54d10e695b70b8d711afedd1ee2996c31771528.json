{"nodes": [{"id": "references_recursion_ch3_ref_87_deco", "label": "DECO: Liberating Web Data Using Decentralized Oracles for TLS", "file_type": "paper", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "Fan Zhang, Deepak Maram, Harjasleen Malvai, Steven Goldfeder, Ari Juels", "contributor": null}, {"id": "fan_zhang", "label": "Fan Zhang", "file_type": "concept", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ari_juels", "label": "Ari Juels", "file_type": "concept", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "decentralized_oracle", "label": "Decentralized Oracle", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Server-facilitated oracles break legacy compatibility and let websites censor data export, while TEE-based oracles inherit trusted-hardware attack risk; DECO's decentralized oracle proves TLS data provenance without trusted hardware or server-side modifications so anyone can be an oracle for any website."}, {"id": "three_party_handshake", "label": "Three-Party Handshake", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Because TLS symmetric session keys let the client forge arbitrary session data, DECO runs a handshake among prover, verifier, and unmodified web server that yields an unforgeable commitment to TLS session data while preserving TLS security against a malicious verifier."}, {"id": "selective_opening", "label": "Selective Opening", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Generic verifiable decryption of TLS records in zero knowledge would cost about 1024 AES invocations per record; exploiting the MAC-then-encrypt CBC-HMAC record structure reduces this to 3 AES invocations when revealing only substrings."}, {"id": "two_stage_parsing", "label": "Two-Stage Parsing", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A revealed substring can be quoted out of context; two-stage parsing preprocesses the session content so only a much smaller outcome must be parsed to prove context integrity for key-value grammars like JSON."}, {"id": "transport_layer_security", "label": "Transport Layer Security", "file_type": "concept", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "town_crier", "label": "Town Crier", "file_type": "paper", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "tlsnotary", "label": "TLSNotary", "file_type": "concept", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "secure_multiparty_computation", "label": "Secure Multi-Party Computation", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "zero_knowledge_proof", "label": "Zero-Knowledge Proof", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_recursion_ch3_ref_87_deco", "target": "fan_zhang", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_87_deco", "target": "ari_juels", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_87_deco", "target": "decentralized_oracle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_87_deco", "target": "three_party_handshake", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_87_deco", "target": "selective_opening", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_87_deco", "target": "two_stage_parsing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_87_deco", "target": "transport_layer_security", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_87_deco", "target": "secure_multiparty_computation", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_87_deco", "target": "zero_knowledge_proof", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_87_deco", "target": "town_crier", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_87_deco", "target": "tlsnotary", "relation": "cites", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "three_party_handshake", "target": "decentralized_oracle", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}, {"source": "two_stage_parsing", "target": "selective_opening", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-87-deco.pdf", "source_location": null, "weight": 1.0}], "hyperedges": []}