{"nodes": [{"id": "references_snowball_book_ref_071_succinct_non_interactive_zero_knowledge_for_a_vo", "label": "Succinct Non-Interactive Zero Knowledge for a von Neumann Architecture", "file_type": "paper", "source_file": "references/snowball/book/ref-071-succinct-non-interactive-zero-knowledge-for-a-vo.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": "Eli Ben-Sasson, Alessandro Chiesa, Eran Tromer, Madars Virza", "contributor": null}, {"id": "vntinyram", "label": "vnTinyRAM", "file_type": "concept", "source_file": "references/snowball/book/ref-071-succinct-non-interactive-zero-knowledge-for-a-vo.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A von Neumann modification of TinyRAM where program and data share one read/write address space, enabling universal circuit generation, just-in-time compilation, and self-modifying code."}, {"id": "universal_circuit_generator", "label": "Universal Circuit Generator", "file_type": "rationale", "source_file": "references/snowball/book/ref-071-succinct-non-interactive-zero-knowledge-for-a-vo.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prior systems hardcoded the program into the circuit, forcing costly per-program trusted key generation; a universal generator depends only on size bounds, so one setup verifies all programs up to that size, with circuit size additive rather than multiplicative in program size."}], "edges": [{"source": "references_snowball_book_ref_071_succinct_non_interactive_zero_knowledge_for_a_vo", "target": "eli_ben_sasson", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/book/ref-071-succinct-non-interactive-zero-knowledge-for-a-vo.pdf", "source_location": null, "weight": 1.0}, {"source": "references_snowball_book_ref_071_succinct_non_interactive_z