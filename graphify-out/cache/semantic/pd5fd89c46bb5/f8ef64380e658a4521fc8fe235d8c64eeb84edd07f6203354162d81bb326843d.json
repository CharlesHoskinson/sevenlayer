{"nodes": [{"id": "_claude_skills_llm_wiki_references_operations_query_query", "label": "Query Operation", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every claim either carries a wikilink citation to a page read this session, is labeled as non-wiki knowledge, or triggers abstention \u2014 there is no third option."}, {"id": "_claude_skills_llm_wiki_references_operations_query_index_first_read_path", "label": "Index-First Read Path", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Three-level drill-down (root index, category index, page) keeps token cost roughly flat as the wiki grows and guards against answering from a stale or guessed page name."}, {"id": "_claude_skills_llm_wiki_references_operations_query_abstention", "label": "Query Abstention Behavior", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "'I don't have enough in the wiki to answer that' is a correct, complete answer \u2014 always preferable to a confident answer drawn from model memory; the abstention suggests a concrete source to ingest."}, {"id": "_claude_skills_llm_wiki_references_operations_query_parametric_labeling", "label": "Parametric Knowledge Labeling", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Model-memory content must be labeled adjacent and unambiguously ('not from wiki') so the user always knows which parts of an answer are wiki-grounded; the label is not a license to pad answers with model memory."}, {"id": "_claude_skills_llm_wiki_references_operations_query_synthesis_fileback", "label": "Synthesis File-Back", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A well-evidenced answer is preserved as a first-class synthesis page with a two-level citation chain (synthesis -> concept/entity page -> raw source) and a 'Derived page' marker; it is an ingest-grade write with full commit discipline."}], "edges": [{"source": "_claude_skills_llm_wiki_references_operations_query_query", "target": "_claude_skills_llm_wiki_references_operations_query_index_first_read_path", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_operations_query_query", "target": "_claude_skills_llm_wiki_references_operations_query_abstention", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_operations_query_query", "target": "_claude_skills_llm_wiki_references_operations_query_parametric_labeling", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_operations_query_query", "target": "_claude_skills_llm_wiki_references_operations_query_synthesis_fileback", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_operations_query_query", "target": "_claude_skills_llm_wiki_references_conventions_contradiction_handling", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_operations_query_synthesis_fileback", "target": "_claude_skills_llm_wiki_references_operations_ingest_atomic_commit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_operations_query_synthesis_fileback", "target": "_claude_skills_llm_wiki_references_conventions_provenance_marker", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_operations_query_synthesis_fileback", "target": "_claude_skills_llm_wiki_assets_page_templates_synthesis_synthesis_template", "relation": "shares_data_with", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "weight": 1.0}, {"source": "_claude_skills_llm_wiki_references_operations_query_index_first_read_path", "target": "_claude_skills_llm_wiki_references_conventions_moc_discipline", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": ".claude/skills/llm-wiki/references/operations/query.md", "source_location": null, "weight": 1.0}], "hyperedges": []}