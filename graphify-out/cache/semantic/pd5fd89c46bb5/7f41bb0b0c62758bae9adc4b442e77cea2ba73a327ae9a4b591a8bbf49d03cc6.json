{"nodes": [{"id": "references_snowball_book_ref_147_an_algebraic_framework_for_universal_and_updatab", "label": "An Algebraic Framework for Universal and Updatable SNARKs", "file_type": "paper", "source_file": "references/snowball/book/ref-147-an-algebraic-framework-for-universal-and-updatab.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "author_carla_rafols", "label": "Carla R\u00e0fols", "file_type": "concept", "source_file": "references/snowball/book/ref-147-an-algebraic-framework-for-universal-and-updatab.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "author_arantxa_zapico", "label": "Arantxa Zapico", "file_type": "concept", "source_file": "references/snowball/book/ref-147-an-algebraic-framework-for-universal-and-updatab.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_css_argument", "label": "Checkable Subspace Sampling (CSS) Argument", "file_type": "concept", "source_file": "references/snowball/book/ref-147-an-algebraic-framework-for-universal-and-updatab.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Identified as the unifying technical core of universal and updatable pairing-based SNARKs; isolating it enables modular design, fair comparison, and mixing of techniques across constructions."}, {"id": "concept_basilisk", "label": "Basilisk", "file_type": "concept", "source_file": "references/snowball/book/ref-147-an-algebraic-framework-for-universal-and-updatab.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Achieves the smallest known proof size among universal/updatable zkSNARKs at the price of SRS terms for multiplicative gates whose fan-out exceeds a bound."}, {"id": "concept_updatable_srs", "lab