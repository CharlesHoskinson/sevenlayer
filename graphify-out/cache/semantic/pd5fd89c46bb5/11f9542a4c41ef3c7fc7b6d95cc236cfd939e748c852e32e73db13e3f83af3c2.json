-pricing-attacks.pdf", "source_location": null, "weight": 1.0}, {"source": "references_ch08_ref_28_rollup_pricing_attacks", "target": "ethereum", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "weight": 1.0}, {"source": "da_saturation_attack", "target": "data_availability", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "weight": 1.0}, {"source": "prover_killer_attack", "target": "validity_rollup", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "weight": 1.0}, {"source": "da_saturation_attack", "target": "transaction_fee_mechanism", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "weight": 1.0}, {"source": "prover_killer_attack", "target": "transaction_fee_mechanism", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "weight": 1.0}, {"source": "validity_rollup", "target": "rollup", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "weight": 1.0}, {"source": "validity_rollup", "target": "zk_snark", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "weight": 1.0}, {"source": "eip_4844", "target": "data_availability", "relation": "conceptually_related