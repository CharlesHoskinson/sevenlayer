{"nodes": [{"id": "references_ch08_ref_28_rollup_pricing_attacks", "label": "Unaligned Incentives: Pricing Attacks Against Blockchain Rollups", "file_type": "paper", "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "stefanos_chaliasos", "label": "Stefanos Chaliasos", "file_type": "concept", "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "benjamin_livshits", "label": "Benjamin Livshits", "file_type": "concept", "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "da_saturation_attack", "label": "DA-Saturation Attack", "file_type": "rationale", "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Floods the sequencer with data-heavy compute-light transactions (incompressible calldata) to exhaust L1 blob capacity per batch, causing L2 DoS, amplified finality delays (1.45x-2.73x), and protocol losses for under 2 ETH per 30 minutes."}, {"id": "prover_killer_attack", "label": "Prover Killer Attack", "file_type": "rationale", "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Exploits mismatches between EVM gas and proving cycles: underpriced high-proof-cost transactions stall batch proof generation, delaying finality by more than 8 hours (94x) at minimal cost."}, {"id": "transaction_fee_mechanism", "label": "Transaction Fee Mechanism (TFM)", "file_type": "rationale", "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rollup TFMs must price three resource dimensions at once (L2 execution, L1 data availability, L1 settlement/proving); mis-pricing across dimensions enables DoS and finality attacks, so the proposed fix is a multi-dimensional TFM."}, {"id": "rollup", "label": "Rollup (Layer 2 Scaling)", "file_type": "rationale", "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "data_availability", "label": "Data Availability (DA)", "file_type": "rationale", "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "validity_rollup", "label": "Validity (ZK) Rollup", "file_type": "rationale", "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every batch is accompanied by a SNARK verified on L1, giving faster finality than optimistic rollups at the price of proving cost and implementation complexity."}, {"id": "eip_4844", "label": "EIP-4844 (Blob Transactions)", "file_type": "concept", "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_ch08_ref_28_rollup_pricing_attacks", "target": "stefanos_chaliasos", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/ch08/ref-28-rollup-pricing-attacks.pdf", "source_location": null, "weight": 1.0}, {"source": "references_ch08_ref_28_rollup_pricing_attacks", "target": "benjamin_livshits", "relation": "references", "confidence": "EXTRACTED", "confide