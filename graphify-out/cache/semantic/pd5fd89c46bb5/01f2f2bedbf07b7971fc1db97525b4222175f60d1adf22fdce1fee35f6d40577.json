{"nodes": [{"id": "references_mooc_lecture07_transcript_error_correcting_code", "label": "Error-correcting code (n,k,delta)", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture07_transcript_linear_code", "label": "Linear code", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Any linear combination of codewords is a codeword; encoding is a vector-matrix product with the generator matrix, and minimum distance equals minimum weight of a nonzero codeword."}, {"id": "references_mooc_lecture07_transcript_reed_solomon_code", "label": "Reed-Solomon code", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Message viewed as a degree k-1 polynomial evaluated at n public points; distance n-k+1 (optimal), rate and relative distance both constant at n=2k; O(n log n) encoding via FFT."}, {"id": "references_mooc_lecture07_transcript_code_based_polynomial_commitment", "label": "Code-based polynomial commitment (Ligero/Brakedown style)", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Coefficients arranged as a sqrt(d) x sqrt(d) matrix, rows encoded with a linear code, columns Merkle-committed; transparent constant-size setup, plausibly post-quantum, field-agnostic, linear-time hash-and-field prover; tradeoff: sqrt(d) proofs of megabytes in practice."}, {"id": "references_mooc_lecture07_transcript_proximity_test", "label": "Proximity test (random row combination vs opened columns)", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Guarantees the committed matrix is close to a genuinely encoded matrix regardless of the evaluation point; needed because the consistency check alone uses a structured, non-random vector the prover could anticipate."}, {"id": "references_mooc_lecture07_transcript_consistency_test", "label": "Consistency test (evaluation vector-matrix check)", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture07_transcript_ligero", "label": "Ligero", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture07_transcript_brakedown", "label": "Brakedown", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built the PCS from tensor-query IOPs and proved knowledge soundness without an efficient decoding algorithm, freeing the code design space."}, {"id": "references_mooc_lecture07_transcript_orion", "label": "Orion", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code-switching proof composition cuts proof size to O(log^2 d) (~50MB to 5.7MB) and adds an expander-testing algorithm, via graph density, that makes randomly sampled lossless expanders reliable."}, {"id": "references_mooc_lecture07_transcript_tensor_iop", "label": "Tensor-query IOP (Bootle-Chiesa-Groth 2020)", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture07_transcript_expander_graph", "label": "Expander graph", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture07_transcript_lossless_expander", "label": "Lossless expander (near-maximal bipartite expansion)", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Small subsets expand to (1-beta)*g*|S| neighbors; unique-neighbor counting turns small-weight messages into non-zero encodings, which is what gives the recursive Spielman construction constant relative distance."}, {"id": "references_mooc_lecture07_transcript_spielman_code", "label": "Spielman linear-time encodable code (1996; Druk-Ishai 2014)", "file_type": "concept", "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Recursive systematic construction: copy message, expand, recursively encode, expand again; constant rate 1/4 and constant relative distance with strictly linear-time encoding."}], "edges": [{"source": "references_mooc_lecture07_transcript_linear_code", "target": "references_mooc_lecture07_transcript_error_correcting_code", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture07/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture07_transcript_reed_solomon_code", "target": "references_mooc_lecture07_transcript_linear_code", "rel