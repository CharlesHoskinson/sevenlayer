{"nodes": [{"id": "references_ch06_ref_21_neo", "label": "Neo: Lattice-based Folding Scheme for CCS over Small Fields and Pay-per-bit Commitments", "file_type": "paper", "source_file": "references/ch06/ref-21-neo.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "wilson_nguyen", "label": "Wilson Nguyen", "file_type": "concept", "source_file": "references/ch06/ref-21-neo.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "pay_per_bit_commitment", "label": "Pay-per-Bit Commitment", "file_type": "rationale", "source_file": "references/ch06/ref-21-neo.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Commitment costs scale with the bit-width of committed scalars (committing to bits is 32x cheaper than 32-bit values), removing LatticeFold's packing overheads and enabling small prime fields like Goldilocks."}, {"id": "goldilocks_field", "label": "Goldilocks Prime Field (2^64 - 2^32 + 1)", "file_type": "concept", "source_file": "references/ch06/ref-21-neo.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "matrix_commitment", "label": "Matrix Commitment Scheme", "file_type": "rationale", "source_file": "references/ch06/ref-21-neo.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Neo commits to a vector over a small prime field by transforming it into a matrix and committing to that matrix, preserving the linear homomorphism needed for folding."}, {"id": "neutronnova", "label": "NeutronNova", "file_type": "concept", "source_file": "references/ch06/ref-21-neo.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_ch06_ref_21_neo", "target": "wilson_