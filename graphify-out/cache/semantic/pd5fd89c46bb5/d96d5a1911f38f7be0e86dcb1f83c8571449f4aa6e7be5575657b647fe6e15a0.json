": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Multi-level SIS commitments extend Groth's two-tier homomorphic commitments: in the lattice setting messages and commitment outputs are both integers, so composition can continue for d levels, giving O~(N^(1/(d+1)))-sized opening proofs."}, {"id": "references_snowball_hop2_ref_183_doi_10_1007_978_3_030_56880_1_16_lattice_bulletproofs_folding", "label": "Lattice Bulletproofs Folding Technique", "file_type": "concept", "source_file": "references/snowball/hop2/ref-183-doi-10-1007-978-3-030-56880-1-16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Adapts the Bulletproofs recursive folding to Ring-SIS commitments; monomial challenge sets are used because 2/(X^i-X^j) has {-1,0,1} coefficients, which bounds coefficient growth of extracted solutions at each fold."}, {"id": "references_snowball_hop2_ref_183_doi_10_1007_978_3_030_56880_1_16_ring_sis_problem", "label": "(Ring-)Short Integer Solution (Ring-SIS) Problem", "file_type": "concept", "source_file": "references/snowball/hop2/ref-183-doi-10-1007-978-3-030-56880-1-16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_183_doi_10_1007_978_3_030_56880_1_16_soundness_slack", "label": "Soundness Slack (Relaxed Extraction)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-183-doi-10-1007-978-3-030-56880-1-16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Extracted witnesses are larger than honest ones and satisfy only a relaxed equation; the Bulletproofs-style folding gives smaller proofs at the cost of much larger slack, while levelled commitments trade slightly larger proofs for smaller extracted solutions."}, {"id": "references_snowball_hop2_ref_183_doi_10_1007_978_3_030_56880_1_16_bulletproofs_paper", "label": "Bulletproofs: Short Proofs for Confidential Transactions and More", "file_type": "paper", "source_file": "references/snowball/hop2/ref-183-doi-10-1007-978-3-030-56880-1-16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_183_doi_10_1007_978_3_030_56880_1_16_kilian_1992_paper", "label": "Kilian: A Note on Efficient Zero-Knowledge Proofs and Arguments (STOC 1992)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-183-doi-10-1007-978-3-030-56880-1-16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_183_doi_10_1007_978_3_030_56880_1_16_groth16_paper", "label": "Groth16: On the Size of Pairing-Based Non-interactive Arguments", "file_type": "paper", "source_file": "references/snowball/hop2/ref-183-doi-10-1007-978-3-030-56880-1-16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_183_doi_10_1007_978_3_030_56880_1_16_fiat_shamir_transform", "label": "Fiat-Shamir Transform", "file_type": "concept", "source_file": "references/snowball/hop2/ref-183-doi-10-1007-978-3-030-56880-1-16.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_snowball_hop2_ref_183_doi_10_1007_978_3_030_56880_1_16_paper", "target": "references_snowball_hop2_ref_183_doi_10_1007_978_3_030_56880_1_16_jonathan_bootle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-183-doi-10-1007-978-3-030-56880-1-16.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_183_doi_10_1007_978_3_030_56880_1_16_paper", "target": "references_snowball_hop2_ref_183_doi