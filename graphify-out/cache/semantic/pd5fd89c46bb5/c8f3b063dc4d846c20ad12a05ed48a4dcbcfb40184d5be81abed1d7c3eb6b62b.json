{"nodes": [{"id": "_claude_skills_graphify_skill_graphify", "label": "Graphify Skill", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Built around the Karpathy /raw workflow: persistent graph survives sessions, an honest audit trail distinguishes found vs invented edges, and community detection surfaces cross-document connections the user would never think to ask about."}, {"id": "_claude_skills_graphify_skill_audit_trail", "label": "Edge Confidence Audit Trail (EXTRACTED/INFERRED/AMBIGUOUS)", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every edge is tagged so the user knows what was found versus invented; uncertainty is flagged AMBIGUOUS rather than omitted."}, {"id": "_claude_skills_graphify_skill_community_detection", "label": "Community Detection", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_ast_extraction", "label": "Structural AST Extraction", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Deterministic and free \u2014 structural extraction of code avoids LLM token cost entirely."}, {"id": "_claude_skills_graphify_skill_semantic_extraction", "label": "Parallel Semantic Extraction Subagents", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Subagent dispatch in a single message is mandated because sequential one-by-one file reading is 5-10x slower."}, {"id": "_claude_skills_graphify_skill_extraction_cache", "label": "Semantic Extraction Cache", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Avoids re-paying LLM token cost for files already extracted in prior runs."}, {"id": "_claude_skills_graphify_skill_god_nodes", "label": "God Nodes", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_obsidian_export", "label": "Obsidian Vault Export", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_graph_query", "label": "Graph Query (BFS/DFS Traversal)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_query_memory_feedback", "label": "Query Result Feedback Loop", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Answers are saved to graphify-out/memory so the next --update extracts each Q&A as a graph node, improving future queries."}, {"id": "_claude_skills_graphify_skill_incremental_update", "label": "Incremental Update (--update)", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only re-extracts new/changed files to save tokens and time."}, {"id": "_claude_skills_graphify_skill_watch_mode", "label": "Watch Mode Auto-Rebuild", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Code-only changes rebuild via AST with no LLM; doc/image changes only flag needs_update because semantic re-extraction costs tokens. Debounce prevents one rebuild per file during agent write waves."}, {"id": "_claude_skills_graphify_skill_commit_hook", "label": "Post-Commit Rebuild Hook", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Triggers once per commit with no background process, works with any editor; appends to an existing hook rather than replacing it."}, {"id": "_claude_skills_graphify_skill_mcp_server", "label": "Graphify MCP Server", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_graphify_skill_honesty_rules", "label": "Graphify Honesty Rules", "file_type": "rationale", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Never invent an edge; always show token cost and raw cohesion scores; warn before oversized HTML viz \u2014 the graph's value depends on trustworthiness."}, {"id": "_claude_skills_graphify_skill_raw_folder_workflow", "label": "Karpathy /raw Folder Workflow", "file_type": "concept", "source_file": ".claude/skills/graphify/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Drop anything into one folder \u2014 papers, tweets, screenshots, code, notes \u2014 and let structure emerge from extraction rather than manu