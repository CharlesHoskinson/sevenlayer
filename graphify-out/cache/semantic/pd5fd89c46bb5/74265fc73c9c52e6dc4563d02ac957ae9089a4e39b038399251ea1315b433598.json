{"nodes": [{"id": "_claude_skills_llm_wiki_references_operations_scrape_scrape", "label": "Scrape/Crawl Operation", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/scrape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "An optional Claude-Code-only on-ramp: it only prepares raw/ files; the wiki itself is always written by the standard v1 ingest. Crawls always plan first (--plan-only) as a runaway and cost control."}, {"id": "_claude_skills_llm_wiki_references_operations_scrape_surface_gate", "label": "Scrape Surface Gate", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/operations/scrape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fetch attempts on the API sandbox or claude.ai fail or hang (no network, no installs), so the gate forces a clean refusal with fallback options instead of retries or browser downloads."}, {"id": "_claude_skills_llm_wiki_references_operations_scrape_fetcher_tiers", "label": "Fetcher Tier Escalation (http/stealth/dynamic)", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/scrape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Escalation is narrow and signal-based (HTTP 401/403/429, challenge markers, near-zero extracted text) \u2014 not fuzzy guessing; dynamic is the terminal tier and the tier used is recorded in frontmatter."}, {"id": "_claude_skills_llm_wiki_references_operations_scrape_is_verbatim", "label": "is_verbatim Provenance Flag", "file_type": "rationale", "source_file": ".claude/skills/llm-wiki/references/operations/scrape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Distinguishes byte-derived extraction (quotable verbatim) from model-interpreted WebFetch content (paraphrase only) \u2014 preserving the wiki's exact-quote provenance integrity."}, {"id": "_claude_skills_llm_wiki_references_operations_scrape_webfetch_fallback", "label": "WebFetch Fallback", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/scrape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Last-resort single-URL capture when Scrapling is declined or unavailable; output is model-interpreted, so it is stamped is_verbatim: false and may never be quoted verbatim."}, {"id": "_claude_skills_llm_wiki_references_operations_scrape_dedup", "label": "Two-Level Scrape Dedup", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/scrape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "URL normalization (scheme/www/tracking-param variants share one dedup key) plus content-hash comparison makes re-fetching idempotent \u2014 mirrors and variants produce reported skips, not duplicate raw files."}, {"id": "_claude_skills_llm_wiki_references_operations_scrape_scrapling", "label": "Scrapling", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/scrape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "_claude_skills_llm_wiki_references_operations_scrape_trafilatura", "label": "trafilatura", "file_type": "concept", "source_file": ".claude/skills/llm-wiki/references/operations/scrape.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "_claude_skills_llm_wiki_references_operations_scrape_scrape", "target": "_claude_skills_llm_wiki_references_operations_scrape_surface_gate", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1