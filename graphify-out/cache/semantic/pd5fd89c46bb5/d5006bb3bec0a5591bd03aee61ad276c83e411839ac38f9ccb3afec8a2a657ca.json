{"nodes": [{"id": "references_recursion_ch3_ref_53_starkware_recursive_starks_doc", "label": "StarkWare: Recursive STARKs (2022)", "file_type": "document", "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "source_url": "https://www.starknet.io/blog/recursive-starks/", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch3_ref_53_starkware_recursive_starks_recursive_proving", "label": "Recursive STARK Proving", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "source_url": "https://www.starknet.io/blog/recursive-starks/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "A Cairo program that verifies other STARK proofs exploits logarithmic compression: verifying takes roughly log(T) of the T needed to prove, so proofs of proofs are cheap. Recursion removes the compute-resource ceiling on statement size, cuts on-chain verification cost per transaction by orders of magnitude, and reduces latency because statements are proven in parallel as they arrive - a rare case of scale and latency improving together."}, {"id": "references_recursion_ch3_ref_53_starkware_recursive_starks_cairo", "label": "Cairo", "file_type": "concept", "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "source_url": "https://www.starknet.io/blog/recursive-starks/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Created because hand-written constraints greatly limited feature velocity for StarkEx: a CPU Algebraic Intermediate Representation whose single AIR verifies the instruction set, opening proofs for arbitrary computational statements in a faster and safer manner."}, {"id": "references_recursion_ch3_ref_53_starkware_recursive_starks_sharp", "label": "SHARP (Shared Prover)", "file_type": "concept", "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "source_url": "https://www.starknet.io/blog/recursive-starks/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Takes transactions from several separate apps and proves them all in one STARK proof, filling proof capacity faster and improving rate and latency."}, {"id": "references_recursion_ch3_ref_53_starkware_recursive_starks_starkex", "label": "StarkEx", "file_type": "concept", "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "source_url": "https://www.starknet.io/blog/recursive-starks/", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch3_ref_53_starkware_recursive_starks_starknet", "label": "StarkNet", "file_type": "concept", "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "source_url": "https://www.starknet.io/blog/recursive-starks/", "captured_at": "2026-06-13", "author": null, "contributor": null}, {"id": "references_recursion_ch3_ref_53_starkware_recursive_starks_applicative_recursion", "label": "Applicative Recursion", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "source_url": "https://www.starknet.io/blog/recursive-starks/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Application-aware recursion merges both the proofs and their public inputs (state update A to B plus B to C becomes A to C) and compresses rollup data across multiple L2 blocks - independent of and combinable with application-agnostic recursion."}, {"id": "references_recursion_ch3_ref_53_starkware_recursive_starks_l3_deployments", "label": "Layer 3 Deployments", "file_type": "rationale", "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "source_url": "https://www.starknet.io/blog/recursive-starks/", "captured_at": "2026-06-13", "author": null, "contributor": null, "rationale": "Baking the Recursive Verifier statement into a StarkNet smart contract lets proofs be submitted to L2, enabling L3s whose proofs aggregate recursively down to a single proof verified on L2."}], "edges": [{"source": "references_recursion_ch3_ref_53_starkware_recursive_starks_doc", "target": "references_recursion_ch3_ref_53_starkware_recursive_starks_recursive_proving", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_53_starkware_recursive_starks_doc", "target": "references_recursion_ch3_ref_53_starkware_recursive_starks_cairo", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_53_starkware_recursive_starks_doc", "target": "references_recursion_ch3_ref_53_starkware_recursive_starks_sharp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_53_starkware_recursive_starks_doc", "target": "references_recursion_ch3_ref_53_starkware_recursive_starks_starkex", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/recursion/ch3/ref-53-starkware-recursive-starks.md", "source_location": null, "weight": 1.0}, {"source": "references_recursion_ch3_ref_53_starkware_recursive_starks_doc", "target": "references_recursion_ch3_ref_53_starkware_recursive_starks_starknet", "relation": "references", "confidence": "EXTRACTED", "