{"nodes": [{"id": "references_mooc_lecture02_transcript_snark", "label": "SNARK (succinct non-interactive argument of knowledge)", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proof must be sublinear in witness size and verification sublinear in circuit size; strongly succinct in practice means logarithmic (often constant) proof size and verify time, which forces a preprocessing step that summarizes the circuit for the verifier."}, {"id": "references_mooc_lecture02_transcript_zk_snark", "label": "zk-SNARK", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture02_transcript_arithmetic_circuit", "label": "Arithmetic circuit over a finite field", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture02_transcript_trusted_setup_modes", "label": "SNARK setup modes (per-circuit trusted, universal, transparent)", "file_type": "rationale", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Per-circuit trusted setup is worst (Groth16): leaked randomness lets a prover forge proofs, so ceremony machines must be destroyed; universal setup (Plonk/Marlin) runs one ceremony for all circuits; transparent setup (Bulletproofs, STARK) needs no secrets at all."}, {"id": "references_mooc_lecture02_transcript_knowledge_soundness", "label": "Knowledge soundness (extractor definition)", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "If an adversary convinces the verifier, an extractor interacting with it recovers a valid witness with essentially the same probability; SNARGs drop this requirement."}, {"id": "references_mooc_lecture02_transcript_functional_commitment", "label": "Functional commitment scheme", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture02_transcript_polynomial_commitment", "label": "Polynomial commitment scheme", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The trivial scheme (hash the coefficients, send them to open) is not one: proof size and verification must be at most logarithmic in the degree."}, {"id": "references_mooc_lecture02_transcript_vector_commitment", "label": "Vector commitment", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture02_transcript_interactive_oracle_proof", "label": "Interactive oracle proof (IOP)", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Information-theoretic object: the prover sends function oracles, the verifier sends randomness and queries oracles; compiling oracles into functional commitments plus Fiat-Shamir yields a SNARK."}, {"id": "references_mooc_lecture02_transcript_schwartz_zippel_lemma", "label": "Schwartz-Zippel-DeMillo-Lipton lemma", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A nonzero (multivariate) polynomial of total degree d vanishes at a random point with probability at most d/p, giving the random-evaluation zero/equality test that makes SNARKs possible."}, {"id": "references_mooc_lecture02_transcript_groth16", "label": "Groth16", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture02_transcript_marlin", "label": "Marlin", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture02_transcript_stark", "label": "STARK", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture02_transcript_fri", "label": "FRI (hash-based polynomial commitment protocol)", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture02_transcript_zk_rollup", "label": "zkRollup (batch validity proofs for L1 scaling)", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture02_transcript_c2pa_snark", "label": "C2PA image provenance via zk-SNARK", "file_type": "concept", "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "C2PA camera signatures break under newsroom post-processing (resize, crop, grayscale); replacing the signature with a zk-SNARK proves the edited photo derives from a signed original with matching metadata."}], "edges": [{"source": "references_mooc_lecture02_transcript_zk_snark", "target": "references_mooc_lecture02_transcript_snark", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture02_transcript_snark", "target": "references_mooc_lecture02_transcript_arithmetic_circuit", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture02_transcript_snark", "target": "references_mooc_lecture02_transcript_knowledge_soundness", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture02_transcript_knowledge_soundness", "target": "references_mooc_lecture01_transcript_proof_of_knowledge", "relation": "semantically_similar_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture02_transcript_polynomial_commitment", "target": "references_mooc_lecture02_transcript_functional_commitment", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture02/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture02_transcript_vector_commitment", "target": "references_mooc_lecture02_transcript_functional_commitment", "relation": "conceptually_related_to", "confiden