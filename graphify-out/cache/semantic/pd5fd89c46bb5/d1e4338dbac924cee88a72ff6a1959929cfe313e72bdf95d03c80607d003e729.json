{"nodes": [{"id": "references_snowball_hop2_ref_154_eprint_2022_1576", "label": "Folding Schemes with Selective Verification", "file_type": "paper", "source_file": "references/snowball/hop2/ref-154-eprint-2022-1576.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "author_alexandros_zacharakis", "label": "Alexandros Zacharakis", "file_type": "concept", "source_file": "references/snowball/hop2/ref-154-eprint-2022-1576.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_folding_scheme", "label": "Folding Scheme", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-154-eprint-2022-1576.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Reduces the validity of two or more NP statements to a single statement of the same form, so folding cost is comparable to reading the statements and only one SNARK proof is needed for many statements."}, {"id": "concept_selective_verification", "label": "Selective Verification", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-154-eprint-2022-1576.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each verifier checks its own statement with a proof sublinear in the number of aggregated statements, without knowing the others, amortizing prover cost in delegation-as-a-service settings."}, {"id": "concept_relaxed_r1cs", "label": "Relaxed R1CS", "file_type": "concept", "source_file": "references/snowball/hop2/ref-154-eprint-2022-1576.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_vector_commitment", "label": "Vector Commitment", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-154-eprint-2022-1576.pdf", "source_location":