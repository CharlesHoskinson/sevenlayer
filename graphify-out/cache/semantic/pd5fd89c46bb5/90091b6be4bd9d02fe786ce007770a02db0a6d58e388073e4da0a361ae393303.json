{"nodes": [{"id": "references_snowball_hop2_ref_161_doi_10_1007_978_3_319_78381_9_8_short_invertible_elements", "label": "Lyubashevsky-Seiler, Short Invertible Elements in Partially Splitting Cyclotomic Rings (EUROCRYPT 2018)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-161-doi-10-1007-978-3-319-78381-9-8.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Proves all non-zero small-coefficient polynomials in Z_p[X]/(Phi_m(X)) are invertible when p is chosen so the cyclotomic splits into a bounded number of factors \u2014 letting lattice ZK proofs keep optimal sparse \u00b11 challenge sets while X^n+1 splits into 8-16 factors, giving a free 2-3x NTT speedup."}, {"id": "references_snowball_hop2_ref_161_doi_10_1007_978_3_319_78381_9_8_vadim_lyubashevsky", "label": "Vadim Lyubashevsky", "file_type": "concept", "source_file": "references/snowball/hop2/ref-161-doi-10-1007-978-3-319-78381-9-8.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_161_doi_10_1007_978_3_319_78381_9_8_partially_splitting_cyclotomic_rings", "label": "Partially Splitting Cyclotomic Rings", "file_type": "concept", "source_file": "references/snowball/hop2/ref-161-doi-10-1007-978-3-319-78381-9-8.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choosing the prime p so X^n+1 splits into k irreducible factors trades NTT multiplication speed against invertibility of small elements; sufficient congruence conditions on p (e.g. p = 2k+1 mod 4k) guarantee the desired factorization."}, {"id": "references_snowball_hop2_ref_161_doi_10_1007_978_3_319_78381_9_8_challenge_set_invertibility", "label": "Challenge Set Invertibility", "file_type": "concept", "source_file": "references/snowball/hop2/ref-161-doi-10-1007-978-3-319-78381-9-8.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Lattice ZK challenge sets must be large (~2^256), have small norm, and have all non-zero differences invertible; the third property is what previously forced efficiency compromises in ring choice."}, {"id": "references_snowball_hop2_ref_161_doi_10_1007_978_3_319_78381_9_8_number_theoretic_transform", "label": "Number Theoretic Transform (NTT)", "file_type": "concept", "source_file": "references/snowball/hop2/ref-161-doi-10-1007-978-3-319-78381-9-8.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_161_doi_10_1007_978_3_319_78381_9_8_approximate_zero_knowledge_proof", "label": "Approximate (Relaxed) Zero-Knowledge Proofs", "file_type": "concept", "source_file": "references/snowball/hop2/ref-161-doi-10-1007-978-3-319-78381-9-8.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fiat-Shamir-style lattice proofs extract f(s-bar) = c-bar * t with a relaxation factor c-bar rather than the original witness; applications (commitments, verifiable encryption, voting) stay sound only if c-bar is invertible in the ring."}], "edges": [{"source": "references_snowball_hop2_ref_161_doi_10_1007_978_3_319_78381_9_8_vadim_lyubashevsky", "target": "references_snowball_hop2_ref_161_doi_10_1007_978_3_319_78381_9_8_short_invertible_elements", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/hop2/ref-161-doi-10-1007-978-3-319-78381-9-8.html", "source_location": null, "weight": 1.0}, {"source": "references_snowball_hop2_ref_159_doi_10_1007_978_3_031_38554_4_17_gregor_seiler", "target": "references_snowball_hop2_ref_161_doi_10_1007_978_3_319_78381_9_8_short_invertible_elements", "relation": "conceptually_related_to", "confidence": "EXTRACTED", "