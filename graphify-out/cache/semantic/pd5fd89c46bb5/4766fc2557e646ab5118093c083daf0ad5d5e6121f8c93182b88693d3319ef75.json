{"nodes": [{"id": "references_snowball_book_ref_118_sonic_zero_knowledge_snarks_from_linear_size_un", "label": "Sonic: Zero-Knowledge SNARKs from Linear-Size Universal and Updatable Structured Reference Strings", "file_type": "paper", "source_file": "references/snowball/book/ref-118-sonic-zero-knowledge-snarks-from-linear-size-un.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "person_sarah_meiklejohn", "label": "Sarah Meiklejohn", "file_type": "concept", "source_file": "references/snowball/book/ref-118-sonic-zero-knowledge-snarks-from-linear-size-un.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_updatable_srs", "label": "Updatable Structured Reference String", "file_type": "rationale", "source_file": "references/snowball/book/ref-118-sonic-zero-knowledge-snarks-from-linear-size-un.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Circuit-specific trusted setups must be redone for every application and every circuit change, a major deployment barrier; a universal SRS that an open set of participants can continually update is secure as long as any single past contributor destroyed their randomness, and Sonic makes it linear-size instead of quadratic."}, {"id": "concept_structured_reference_string", "label": "Structured Reference String (SRS)", "file_type": "rationale", "source_file": "references/snowball/book/ref-118-sonic-zero-knowledge-snarks-from-linear-size-un.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "concept_universal_snark", "label": "Universal SNARK", "file_type": "rationale", "source_file": "references/snowball/book/ref-118-sonic-zero-knowledge-snarks-from-linear-size-un.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contribut