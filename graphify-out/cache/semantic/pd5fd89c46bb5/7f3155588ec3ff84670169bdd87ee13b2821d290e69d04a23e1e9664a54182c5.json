{"nodes": [{"id": "references_snowball_recursion_ref_137_lattice_based_succinct_arguments_for_np_with_pol", "label": "Lattice-Based Succinct Arguments for NP with Polylogarithmic-Time Verification", "file_type": "paper", "source_file": "references/snowball/recursion/ref-137-lattice-based-succinct-arguments-for-np-with-pol.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "jonathan_bootle", "label": "Jonathan Bootle", "file_type": "concept", "source_file": "references/snowball/recursion/ref-137-lattice-based-succinct-arguments-for-np-with-pol.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "alessandro_chiesa", "label": "Alessandro Chiesa", "file_type": "concept", "source_file": "references/snowball/recursion/ref-137-lattice-based-succinct-arguments-for-np-with-pol.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "katerina_sotiraki", "label": "Katerina Sotiraki", "file_type": "concept", "source_file": "references/snowball/recursion/ref-137-lattice-based-succinct-arguments-for-np-with-pol.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "split_and_fold", "label": "Split-and-Fold Technique", "file_type": "rationale", "rationale": "Split-and-fold arguments exploit the algebraic structure of homomorphic commitments to obtain proofs concretely smaller than Merkle-tree constructions; porting them to lattices is motivated by the analogous win of lattice signatures over hash-based ones.", "source_file": "references/snowball/recursion/ref-137-lattice-based-succinct-arguments-for-np-with-pol.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "leveled_bilinear_modules", "label": "Leveled Bilinear Modules", "file_type": "concept", "rationale": "Introduced so that commitment keys can themselves be committed to (the key space of level i embeds into the message space of level i+1), enabling a delegation protocol that yields polylogarithmic-time verification from lattices while departing from the Merkle-tree paradigm.", "source_file": "references/snowball/recursion/ref-137-lattice-based-succinct-arguments-for-np-with-pol.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "sumcheck_protocol", "label": "Sumcheck Protocol", "file_type": "concept", "source_file": "references/snowball/recursion/ref-137-lattice-based-succinct-arguments-for-np-with-pol.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "ring_sis", "label": "Ring-SIS Assumption", "file_type": "concept", "source_file": "references/snowball/recursion/ref-137-lattice-based-succinct-arguments-for-np-with-pol.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "merkle_tree_paradigm", "label": "Merkle-Tree Paradigm (Kilian)", "file_type": "rationale", "rationale": "Merkle-tree succinct arguments rely only on generic hash functions and are quantum-safe, but their generic primitives inflate concrete proof sizes, which motivates lattice-based homomorphic alternatives.", "source_file": "references/snowball/recursion/ref-137-lattice-based-succinct-arguments-for-np-with-pol.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_snowball_recursion_ref_137_lattice_based_succinct_arguments_for_np_with_pol", "target": "jonathan_bootle", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/snowball/recursion/ref-137-lattice-based-succinct-arguments-for-np-with-pol.pdf", "source_location": null, "weight": 1.0}, {"source": "references_snowba