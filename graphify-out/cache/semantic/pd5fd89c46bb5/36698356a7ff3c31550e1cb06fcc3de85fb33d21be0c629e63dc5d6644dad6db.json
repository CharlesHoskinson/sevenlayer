{"nodes": [{"id": "references_recursion_ch1_ref_19_ef_l1_zkevm_realtime_proving", "label": "Ethereum Foundation: Shipping an L1 zkEVM #1 - Realtime Proving (2025)", "file_type": "document", "source_file": "references/recursion/ch1/ref-19-ef-l1-zkevm-realtime-proving.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/10/realtime-proving", "captured_at": "2026-06-13", "author": "Sophia Gold", "contributor": null}, {"id": "references_recursion_ch1_ref_19_ef_l1_zkevm_realtime_proving_realtime_proving_definition", "label": "EF Realtime Proving Definition", "file_type": "rationale", "source_file": "references/recursion/ch1/ref-19-ef-l1-zkevm-realtime-proving.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/10/realtime-proving", "captured_at": "2026-06-13", "author": "Sophia Gold", "contributor": null, "rationale": "Latency <=10s for P99 of mainnet blocks, on-prem CAPEX <=$100k, power <=10kW, fully open source, >=128-bit security (100-bit accepted initially), proof <=300KiB with no trusted-setup recursive wrappers. Thresholds chosen so solo home stakers can prove, preserving liveness and censorship resistance rather than optimizing for cloud provers."}, {"id": "references_recursion_ch1_ref_19_ef_l1_zkevm_realtime_proving_l1_zkevm", "label": "L1 zkEVM Plan", "file_type": "rationale", "source_file": "references/recursion/ch1/ref-19-ef-l1-zkevm-realtime-proving.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/07/10/realtime-proving", "captured_at": "2026-06-13", "author": "Sophia Gold", "contributor": null, "rationale": "Validators optionally run clients that statelessly verify multiple proofs from different zkVMs proving different EVM implementations - defense in depth mirroring client diversity; once a supermajority is comfortable, raise the gas limit, and reuse the proofs for an EXECUTE precompile enabling native rollups."}], "edges": [{"source": "references_recursion_ch1_ref_19_ef_l1_zkev