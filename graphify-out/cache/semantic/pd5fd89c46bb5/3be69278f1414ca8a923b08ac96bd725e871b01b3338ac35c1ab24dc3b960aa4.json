{"nodes": [{"id": "references_mooc_lecture09_transcript", "label": "MOOC Lecture 9: SNARKs from Linear PCPs and Quadratic Arithmetic Programs", "file_type": "document", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null}, {"id": "references_mooc_lecture09_transcript_linear_pcp", "label": "Linear PCP", "file_type": "concept", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null, "rationale": "Oracle is a linear function (vector); verifier submits linear queries answered by inner products. Predates polynomial IOPs and underlies the earliest practical SNARK implementations."}, {"id": "references_mooc_lecture09_transcript_quadratic_arithmetic_program", "label": "Quadratic Arithmetic Program (QAP)", "file_type": "rationale", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null, "rationale": "Reduces circuit satisfiability to one polynomial identity: L(x)*R(x)-O(x) divisible by the vanishing polynomial. Selector tables are public, sparse, and circuit-derived, so keys are generated in linear time; addition gates are absorbed into the selector sums for free. GGPR13's QAP cut prover cost from quadratic to quasi-linear, enabling Pinocchio and Groth16."}, {"id": "references_mooc_lecture09_transcript_groth16", "label": "Groth16 SNARK", "file_type": "rationale", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null, "rationale": "Smallest known proofs (3 group elements, ~144 bytes) and one pairing-equation verification under the generic group model; the price is a circuit-specific trusted setup, a relatively slow FFT+multiexponentiation prover, and no post-quantum security."}, {"id": "references_mooc_lecture09_transcript_pinocchio", "label": "Pinocchio (PGHR13)", "file_type": "concept", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null, "rationale": "One of the earliest efficient SNARK systems: 5-element proofs from QAP + bilinear pairings, with KOE-based consistency checks and public-input splitting."}, {"id": "references_mooc_lecture09_transcript_selector_polynomials", "label": "Selector Polynomials", "file_type": "concept", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null, "rationale": "Interpolated over roots of unity to select the left/right inputs and output of each multiplication gate; addition gates are handled implicitly inside the summations."}, {"id": "references_mooc_lecture09_transcript_r1cs", "label": "Rank-1 Constraint System (R1CS)", "file_type": "rationale", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null, "rationale": "Generalizes 0/1 selector values to arbitrary public constants, so each constraint is (linear combo)*(linear combo)=(linear combo); additions and multiplications by constants are nearly free, and the matrix view (Az o Bz = Cz) underlies Spartan, Marlin, Bulletproofs and Nova."}, {"id": "references_mooc_lecture09_transcript_bilinear_pairing", "label": "Bilinear Pairing", "file_type": "concept", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null}, {"id": "references_mooc_lecture09_transcript_knowledge_of_exponent_assumption", "label": "Knowledge of Exponent Assumption", "file_type": "concept", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null}, {"id": "references_mooc_lecture09_transcript_generic_group_model", "label": "Generic Group Model", "file_type": "concept", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null}, {"id": "references_mooc_lecture09_transcript_circuit_specific_trusted_setup", "label": "Circuit-Specific Trusted Setup", "file_type": "rationale", "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": "Yupeng Zhang", "contributor": null, "rationale": "Proving/verification keys embed selector polynomial evaluations at a secret tau that must be destroyed; the setup must be re-run for every new circuit, unlike Plonk/Marlin's universal setup."}], "edges": [{"source": "references_mooc_lecture09_transcript", "target": "references_mooc_lecture09_transcript_linear_pcp", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture09_transcript", "target": "references_mooc_lecture09_transcript_quadratic_arithmetic_program", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture09_transcript", "target": "references_mooc_lecture09_transcript_groth16", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture09/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture09_transcript", "target": "references_mooc_lectu