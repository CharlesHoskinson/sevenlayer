{"nodes": [{"id": "references_ch10_ref_55_zkevm_security_foundations_l1_zkevm_security_initiative", "label": "EF L1 zkEVM security foundations initiative", "file_type": "concept", "source_file": "references/ch10/ref-55-zkevm-security-foundations.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/12/18/zkevm-security-foundations", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "After the performance sprint (16 min -> 16 s latency, 45x cost drop, 99% of blocks under 10 s), security is the elephant in the room; the strategy is to lock security targets now so architectures stabilize enough for formal verification by H-star."}, {"id": "references_ch10_ref_55_zkevm_security_foundations_provable_security_128_bit", "label": "128-bit provable security target", "file_type": "rationale", "source_file": "references/ch10/ref-55-zkevm-security-foundations.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/12/18/zkevm-security-foundations", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "STARK conjectures are being mathematically disproven, silently shaving advertised bits (100 may really be 80); a soundness break lets an attacker forge anything - mint tokens, rewrite state, steal funds - so for an L1 zkEVM the margin is non-negotiable; 128 bits matches standardization-body recommendations."}, {"id": "references_ch10_ref_55_zkevm_security_foundations_soundcalc", "label": "soundcalc (zkVM security estimator)", "file_type": "concept", "source_file": "references/ch10/ref-55-zkevm-security-foundations.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/12/18/zkevm-security-foundations", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "Estimates zkVM security from latest cryptographic bounds and proof-system parameters; a living tool giving common ground for security assessments."}, {"id": "references_ch10_ref_55_zkevm_security_foundations_milestone_glamsterdam", "label": "Milestone 2: Glamsterdam (100-bit provable, <=600 KiB, May 2026)", "file_type": "concept", "source_file": "references/ch10/ref-55-zkevm-security-foundations.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/12/18/zkevm-security-foundations", "captured_at": "2026-06-12", "author": null, "contributor": null}, {"id": "references_ch10_ref_55_zkevm_security_foundations_milestone_h_star", "label": "Milestone 3: H-star (128-bit provable, <=300 KiB, end 2026)", "file_type": "concept", "source_file": "references/ch10/ref-55-zkevm-security-foundations.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/12/18/zkevm-security-foundations", "captured_at": "2026-06-12", "author": null, "contributor": null}, {"id": "references_ch10_ref_55_zkevm_security_foundations_whir", "label": "WHIR (compact polynomial commitment scheme)", "file_type": "concept", "source_file": "references/ch10/ref-55-zkevm-security-foundations.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/12/18/zkevm-security-foundations", "captured_at": "2026-06-12", "author": null, "contributor": null}, {"id": "references_ch10_ref_55_zkevm_security_foundations_recursion_architecture", "label": "zkEVM recursion architecture and its soundness", "file_type": "rationale", "source_file": "references/ch10/ref-55-zkevm-security-foundations.md", "source_location": null, "source_url": "https://blog.ethereum.org/2025/12/18/zkevm-security-foundations", "captured_at": "2026-06-12", "author": null, "contributor": null, "rationale": "Modern zkEVMs compose many circuits with recursion in custom ways with lots of glue; documenting each team's topology and its soundness is essential for whole-system security."}, {"id": "references_ch10_ref_55_zkevm_security_foundations_ethereum_foundation", "label": "Ethereum Foundation cryptography team", "file_type": "concept", "source_file": "references/ch10/ref-55-zkevm-s