{"nodes": [{"id": "docs_superpowers_specs_2026_06_12_deepen_pdf_graph_design_spec", "label": "Deep PDF Mining Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-12-deepen-pdf-graph-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_12_deepen_pdf_graph_design_additive_anchored_extraction", "label": "Additive Anchored Extraction", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-12-deepen-pdf-graph-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Additive so existing chapter-to-paper cross-edges survive; anchored to each paper's existing node ids so new deep nodes attach to the right place in the graph."}, {"id": "docs_superpowers_specs_2026_06_12_deepen_pdf_graph_design_additive_invariant", "label": "Additive Invariant (node count never decreases)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-deepen-pdf-graph-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_12_deepen_pdf_graph_design_concept_kebab_ids", "label": "Shared concept_<kebab> Node IDs", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-deepen-pdf-graph-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Shared concept ids are how distinct papers interlink on merge - the source of cross-paper surprising connections; imprecise names risk wrongly merging distinct concepts."}, {"id": "docs_superpowers_specs_2026_06_12_deepen_pdf_graph_design_extraction_contract", "label": "Subagent Extraction Contract", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-deepen-pdf-graph-design.md", "source_location": null, "source_url