{"nodes": [{"id": "references_snowball_hop2_ref_159_doi_10_1007_978_3_031_38554_4_17_labrador", "label": "Beullens-Seiler, LaBRADOR: Compact Proofs for R1CS from Module-SIS (CRYPTO 2023)", "file_type": "paper", "source_file": "references/snowball/hop2/ref-159-doi-10-1007-978-3-031-38554-4-17.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First lattice-based proof system more compact than hash-based PCP-type systems: 58 KB proofs for R1CS mod 2^64+1 with 2^20 constraints at 128-bit security, an order of magnitude smaller than previous quantum-safe proofs, by allowing the stronger Module-SIS assumption."}, {"id": "references_snowball_hop2_ref_159_doi_10_1007_978_3_031_38554_4_17_ward_beullens", "label": "Ward Beullens", "file_type": "concept", "source_file": "references/snowball/hop2/ref-159-doi-10-1007-978-3-031-38554-4-17.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_159_doi_10_1007_978_3_031_38554_4_17_gregor_seiler", "label": "Gregor Seiler", "file_type": "concept", "source_file": "references/snowball/hop2/ref-159-doi-10-1007-978-3-031-38554-4-17.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_snowball_hop2_ref_159_doi_10_1007_978_3_031_38554_4_17_recursive_amortization", "label": "Recursive Amortization", "file_type": "concept", "source_file": "references/snowball/hop2/ref-159-doi-10-1007-978-3-031-38554-4-17.html", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "LaBRADOR stands for Lattice-Based Recursively Amortized Demonstration Of R1CS: repeated amortized self-reduction compresses the proof instead of a single-shot PCP compilation."}, {"id": "references_snowball_hop2_ref_159_doi_10_1007_978_3_031_38554_4_17_ligero", "label": "Ligero (A