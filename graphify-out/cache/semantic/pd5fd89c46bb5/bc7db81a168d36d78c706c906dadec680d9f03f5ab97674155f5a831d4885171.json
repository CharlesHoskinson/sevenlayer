{"nodes": [{"id": "references_snowball_hop2_ref_254_eprint_2022_1763", "label": "cq: Cached Quotients for Fast Lookups", "file_type": "paper", "source_file": "references/snowball/hop2/ref-254-eprint-2022-1763.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "liam_eagen", "label": "Liam Eagen", "file_type": "concept", "source_file": "references/snowball/hop2/ref-254-eprint-2022-1763.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "dario_fiore", "label": "Dario Fiore", "file_type": "concept", "source_file": "references/snowball/hop2/ref-254-eprint-2022-1763.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "cq_protocol", "label": "cq Lookup Argument (Cached Quotients)", "file_type": "rationale", "source_file": "references/snowball/hop2/ref-254-eprint-2022-1763.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Caches per-Lagrange-basis quotient commitments in an O(N log N) preprocessing step so the prover can run the logarithmic-derivative lookup directly on the original large table, avoiding subtable extraction on arbitrary point sets (the O(n log^2 n) bottleneck of Flookup and Baloo); keeping all prover-defined pairing arguments in G1 makes proofs conveniently aggregatable and table commitments stay homomorphic for vector lookups."}, {"id": "feist_khovratovich", "label": "Feist-Khovratovich Technique", "file_type": "concept", "source_file": "references/snowball/hop2/ref-254-eprint-2022-1763.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_snowball_hop2_ref_254_eprint_2022_1763", "target": "liam_eagen", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "referen