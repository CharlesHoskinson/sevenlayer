{"nodes": [{"id": "references_mooc_lecture05_transcript_plonk_iop", "label": "Plonk polynomial IOP", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Encodes the computation trace as one polynomial T over a multiplicative subgroup and verifies four things: correct public inputs (ZeroTest vs v(X)), correct gates (selector polynomial S), correct wiring (T invariant under rotation permutation W), and zero output; abstract IOP combinable with any PCS - KZG gives Aztec/JellyFish, Bulletproofs gives Halo2, FRI gives Plonky2."}, {"id": "references_mooc_lecture05_transcript_computation_trace", "label": "Computation trace arithmetization (trace table)", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture05_transcript_vanishing_polynomial", "label": "Vanishing polynomial Z_Omega (X^k - 1 on roots of unity)", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Choosing Omega as a multiplicative subgroup makes Z_Omega evaluable in O(log k), which keeps the verifier logarithmic."}, {"id": "references_mooc_lecture05_transcript_zero_test", "label": "ZeroTest on a set Omega (quotient by vanishing polynomial)", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "f is zero on Omega iff Z_Omega divides f; the prover can only KZG-commit to the quotient if it is a genuine polynomial, which is what proves divisibility."}, {"id": "references_mooc_lecture05_transcript_product_check", "label": "ProductCheck (prefix-product auxiliary polynomial t)", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture05_transcript_sumcheck_gadget", "label": "SumCheck gadget over Omega", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture05_transcript_permutation_check", "label": "Permutation check (Lipton's root-polynomial trick)", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture05_transcript_prescribed_permutation_check", "label": "Prescribed permutation check (bivariate pair encoding)", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Direct ZeroTest on f(y)-g(W(y)) would compose degrees to k^2 and force a quadratic prover; encoding (W(a),f(a)) vs (a,g(a)) pairs as bivariate root polynomials reduces it to a linear-time ProductCheck."}, {"id": "references_mooc_lecture05_transcript_plonkish_arithmetization", "label": "Plonkish arithmetization (custom gates)", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture05_transcript_plookup", "label": "Plookup (lookup arguments in Plonkish tables)", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifying membership of table values in predefined lists shrinks trace rows and thus prover time."}, {"id": "references_mooc_lecture05_transcript_hyperplonk", "label": "HyperPlonk", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the subgroup Omega with the Boolean hypercube and T with a multilinear polynomial, turning quasilinear ZeroTests into linear-time operations for a linear-time prover."}, {"id": "references_mooc_lecture05_transcript_halo2", "label": "Halo2", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "references_mooc_lecture05_transcript_plonky2", "label": "Plonky2", "file_type": "concept", "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "references_mooc_lecture05_transcript_plonk_iop", "target": "references_mooc_lecture05_transcript_computation_trace", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture05_transcript_zero_test", "target": "references_mooc_lecture05_transcript_vanishing_polynomial", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture05/transcript.txt", "source_location": null, "weight": 1.0}, {"source": "references_mooc_lecture05_transcript_product_check", "target": "references_mooc_lecture05_transcript_zero_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "references/mooc/lecture05/transcript.txt", "sou