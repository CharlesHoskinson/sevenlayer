{"nodes": [{"id": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_spec", "label": "ePrint Cloudflare Stealth Tier Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-06-12-eprint-cloudflare-stealth-tier-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_stealth_tier", "label": "Cloudflare Stealth Tier", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-eprint-cloudflare-stealth-tier-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A stealth browser clears the challenge once per origin; curl_cffi then reuses the harvested session so unattended --force reruns and fresh clones succeed without a manual cookie harvest."}, {"id": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_cf_clearance_reuse", "label": "cf_clearance Cookie + UA Reuse", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-eprint-cloudflare-stealth-tier-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "cf_clearance is bound to the exact user-agent that minted it, so cookie and UA are harvested together and replayed on the curl_cffi download."}, {"id": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_pdf_url_clearing", "label": "Clear the Challenged PDF URL", "file_type": "rationale", "source_file": "docs/superpowers/specs/2026-06-12-eprint-cloudflare-stealth-tier-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "eprint's Cloudflare challenge is scoped to the PDF asset paths; the landing page serves 200 unchallenged and never mints cf_clearance, so solve_cloudflare must run against the failing PDF URL itself."}, {"id": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_verification_results", "label": "Live Verification Results (refs 6/17/45)", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-06-12-eprint-cloudflare-stealth-tier-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "First run failed (landing-page clearing found no challenge); after the clear-URL fix the PDF-URL clear solved the managed Turnstile, produced a byte-identical 404221-byte PDF, and the origin cache amortized the solve across refs 17 and 45."}], "edges": [{"source": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_spec", "target": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_stealth_tier", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-12-eprint-cloudflare-stealth-tier-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_spec", "target": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_cf_clearance_reuse", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-12-eprint-cloudflare-stealth-tier-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_spec", "target": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_pdf_url_clearing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-06-12-eprint-cloudflare-stealth-tier-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_06_12_eprint_cloudflare_stealth_tier_design_spec", "target": "docs_supe